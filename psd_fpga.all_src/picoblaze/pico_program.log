           │
186        │                            ; GLE: 10-Nov-2025 (We need to start the tdc)
186        │                            ; start_tdc looks to see if this is board 0 or not!
           │
186  2007D ╰──────⤙                     call start_tdc
           │
187        │                            ; Turn led[0] on (On while we wait for take_event to go high!)
           │
187  05A01 │    ╭─▶              .loop: or led_reg, 01                 ; Set bit 0
188  2DA00 │    │                       output led_reg, LED_PORT
           │    │
189        │    │                       ; Wait for take_event to go HIGH
189        │    │                       ; Take event is bit 1 of the STATUS_IPORT
           │    │
189  09100 │    │╭▶             .wait0: input ip, STATUS_IPORT
18A  0D102 │    ││                      test ip, 02                    ; Test bit 1
18B  32189 │    │╰⤙                     jump Z, .wait0
           │    │
