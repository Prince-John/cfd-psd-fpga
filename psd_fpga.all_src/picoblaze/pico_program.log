084        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
084        │   │                        ; Subroutine Name: tdc_serial
           │   │                        ;
084        │   │                        ; Routine to send and receive serial dataa
084        │   │                        ; from TDC7200. Used to send both internal
084        │   │                        ; register address and data to the TDC7200
           │   │                        ;
084        │   │                        ; We should enter with cnt register containing
084        │   │                        ; number of clock pulses we want
           │   │                        ;
084        │   │                        ; Make sure the tdc_csb is LOW when this routine
084        │   │                        ; is called!
           │   │                        ;
084        │   │                        ; Minimum sclk period for the TDC7200 is 50 ns
           │   │                        ;
084        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │   │
084        │   │            tdc_serial:
           │   │
084        │   │                        ; Bring the shift control on tdc register high!
           │   │
084  05B10 │  ╭┴┬─▶                     or tdc_ctl_reg, 10             ; Set bit 4
085  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
           │  │ │
086        │  │ │                       ; Apply clock pulses (number in cnt register)
086        │  │ │                       ; Use scr0 as a clock mask (tdc_sclk is bit 5)
           │  │ │
086  01200 │  │ │                       load scr0, 00
087  05220 │  │ │                       or scr0, 20                    ; Set bit 5
088  06B20 │  │ │╭▶          .clk_loop: xor tdc_ctl_reg, scr0
089  2DB04 │  │ ││                      output tdc_ctl_reg, TDC_CTL_PORT
08A        │  │ ││                      ;			nop
08A        │  │ ││                      ;			nop
08A  06B20 │  │ ││                      xor tdc_ctl_reg, scr0
08B  2DB04 │  │ ││                      output tdc_ctl_reg, TDC_CTL_PORT
08C  19401 │  │ ││                      sub cnt, 01
08D  36088 │  │ │╰⤙                     jump NZ, .clk_loop
           │  │ │
08E        │  │ │                       ; Bring the shift control on tdc register low!
           │  │ │
08E  03BEF │  │ │                       and tdc_ctl_reg, ef            ; Clear bit 4
08F  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
           │  │ │
090  25000 │  │ │                       return
           │  │ │
