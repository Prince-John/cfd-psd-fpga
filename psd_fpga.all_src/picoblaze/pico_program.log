           ││││││                       ;
05E        ││││││                       ; This routine will enable the TDC7200
05E        ││││││                       ; We do this by bringing the tdc_enable (Bit 7) low
05E        ││││││                       ; and then bring it high. Enable must be high
05E        ││││││                       ; for TDC7200 to perform conversions.
           ││││││                       ;
05E        ││││││                       ; GLE: 8-Nov-2025 (added two more dly_us calls)
           ││││││                       ;
05E        ││││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││││││
05E  03B7F ╰──────▶            tdc_ena: and tdc_ctl_reg, 7f            ; Clear bit 7
05F  2DB04 ││││││                       output tdc_ctl_reg, TDC_CTL_PORT
060  20034 │╰─────⤙                     call dly_us
061  20034 ╰──────⤙                     call dly_us
062  20034 ╰──────⤙                     call dly_us
063  05B80 │ ││││                       or tdc_ctl_reg, 80             ; Set bit 7
064  2DB04 │ ││││                       output tdc_ctl_reg, TDC_CTL_PORT
065  25000 │ ││││                       return
           │ ││││
066        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
066        │ ││││                       ; Subroutine Name: config_tdc
           │ ││││                       ;
066        │ ││││                       ; When we enter, addr_reg should contain the configuration
066        │ ││││                       ; register address we want to load, either CONFGI1 or CONFIG2
           │ ││││                       ;
066        │ ││││                       ; Also, when we enter, op register should contain the
066        │ ││││                       ; configuration value, either CONFIG1_VAL or CONFIG2_VAL
           │ ││││                       ;
066        │ ││││                       ; Loads the TDC7200 CONFIG1 or CONFIG2 register
066        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │ ││││
066  20052 │╭───┴┬▶         config_tdc: call clr_tdc_reg
           │││││ │
067        │││││ │                      ; Load address information and write to TDC_DATA_PORT
067        │││││ │                      ; addr_reg is passed into routine and contains address
067        │││││ │                      ; of TDC7200 register we want to load!
           │││││ │
067  2DD03 │││││ │                      output addr_reg, TDC_DATA_PORT
           │││││ │
068        │││││ │                      ; Assert ld[2] control (most significant byte of tdc register)
068        │││││ │                      ; Synchronous load so we need to apply a clock pulse!
068        │││││ │                      ; ld[2] is bit 2 of the TDC_CTL_PORT
           │││││ │
068  05B04 │││││ │                      or tdc_ctl_reg, 04             ; Set bit 2
069  2DB04 │││││ │                      output tdc_ctl_reg, TDC_CTL_PORT
06A  2004D ││╰────⤙                     call tdc_reg_clk
06B  03BFB ││ ││ │                      and tdc_ctl_reg, fb            ; Clear bit 2
06C  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
06D        ││ ││ │                      ; Write value to TDC_DATA_PORT
06D        ││ ││ │                      ; The op register is passed into routine and contains the data value
           ││ ││ │
06D  2D003 ││ ││ │                      output op, TDC_DATA_PORT
           ││ ││ │
06E        ││ ││ │                      ; Assert ld[1] control (middle byte of tdc register)
06E        ││ ││ │                      ; ld[1] is bit 1 of TDC_CTL_PORT
           ││ ││ │
06E  05B02 ││ ││ │                      or tdc_ctl_reg, 02             ; Set bit 1
06F  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
070  2004D ╰──────⤙                     call tdc_reg_clk
071  03BFD ││ ││ │                      and tdc_ctl_reg, fd            ; Clear bit 1
072  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
073        ││ ││ │                      ; Bring tdc_csb pin low (active)
           ││ ││ │
073  20058 ││ │╰──⤙                     call tdc_csb_low
           ││ │  │
074        ││ │  │                      ; Load cnt with the number of clock pulses we want i.e. 16
074        ││ │  │                      ; We need 8 clocks to load register address and 8 to load the value
074        ││ │  │                      ; Address goes in first followed by data
           ││ │  │
074  01410 ││ │  │                      load cnt, 16'd
           ││ │  │
075        ││ │  │                      ; Call our TDC serial routine
           ││ │  │
075  20083 ││ │╭──⤙                     call tdc_serial
           ││ ││ │
076        ││ ││ │                      ; Bring tdc_csb pin high (inactive)
           ││ ││ │
076  2005B ││ ╰───⤙                     call tdc_csb_high
           ││  │ │
077  25000 ││  │ │                      return
           ││  │ │
078        ││  │ │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
078        ││  │ │                      ; Subroutine Name: tdc_init
           ││  │ │                      ;
078        ││  │ │                      ; Routine to initialize the TDC7200 and related circuits
078        ││  │ │                      ; --> Load the CONFIG2 register
078        ││  │ │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││  │ │
078        ││  │ │            tdc_init:
           ││  │ │
078        ││  │ │                      ; Load config data into CONFIG2 register
078        ││  │ │                      ; This only needs to be done once!!!!!
078        ││  │ │                      ; addr_reg needs to be loaded with address
078        ││  │ │                      ; op needs to be loaded with value to be stored at address
           ││  │ │
078  01D41 ╰──────▶                     load addr_reg, CONFIG2
079  01001 ││  │ │                      load op, CONFIG2_VAL
07A  20066 ││  │ ╰⤙                     call config_tdc
07B  25000 ││  │                        return
           ││  │
07C        ││  │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
07C        ││  │                        ; Subroutine Name: start_tdc
           ││  │                        ;
07C        ││  │                        ; This routine will start a measurement on TDC7200
07C        ││  │                        ; Only starts if this is board 0!
           ││  │                        ;
07C        ││  │                        ; Measurements are started by writing to CONFIG1 with
07C        ││  │                        ; the least significant bit set!
           ││  │                        ;
07C        ││  │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││  │
07C        ││  │             start_tdc:
           ││  │
07C        ││  │                        ; If this is board 0 then start the TDC
           ││  │
07C  0B200 ╭──────▶                     fetch scr0, BOARD_ID
07D  1D200 ││  │                        compare scr0, 00
07E  36082 ││  │ ╭⤙                     jump NZ, .done
           ││  │ │
07F        ││  │ │                      ; We start the TDC7200 by writing to CONFIG1
           ││  │ │
07F  01D40 ││  │ │                      load addr_reg, CONFIG1
080  01001 ││  │ │                      load op, CONFIG1_VAL
081  20066 │╰─────⤙                     call config_tdc
           │   │ │
082  25000 │   │ ╰▶              .done: return
           │   │
083        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
083        │   │                        ; Subroutine Name: tdc_serial
           │   │                        ;
083        │   │                        ; Routine to send and receive serial dataa
083        │   │                        ; from TDC7200. Used to send both internal
083        │   │                        ; register address and data to the TDC7200
           │   │                        ;
083        │   │                        ; We should enter with cnt register containing
083        │   │                        ; number of clock pulses we want
           │   │                        ;
083        │   │                        ; Make sure the tdc_csb is LOW when this routine
083        │   │                        ; is called!
           │   │                        ;
083        │   │                        ; Minimum sclk period for the TDC7200 is 50 ns
           │   │                        ;
083        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │   │
083        │   │            tdc_serial:
           │   │
083        │   │                        ; Bring the shift control on tdc register high!
           │   │
083  05B10 │   ╰┬─▶                     or tdc_ctl_reg, 10             ; Set bit 4
084  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
           │    │
085        │    │                       ; Apply clock pulses (number in cnt register)
085        │    │                       ; Use scr0 as a clock mask (tdc_sclk is bit 5)
           │    │
085  01200 │    │                       load scr0, 00
086  05220 │    │                       or scr0, 20                    ; Set bit 5
087  06B20 │    │╭▶          .clk_loop: xor tdc_ctl_reg, scr0
088  2DB04 │    ││                      output tdc_ctl_reg, TDC_CTL_PORT
089        │    ││                      ;			nop
089        │    ││                      ;			nop
089  06B20 │    ││                      xor tdc_ctl_reg, scr0
08A  2DB04 │    ││                      output tdc_ctl_reg, TDC_CTL_PORT
08B  19401 │    ││                      sub cnt, 01
08C  36087 │    │╰⤙                     jump NZ, .clk_loop
           │    │
08D        │    │                       ; Bring the shift control on tdc register low!
           │    │
08D  03BEF │    │                       and tdc_ctl_reg, ef            ; Clear bit 4
08E  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
           │    │
08F  25000 │    │                       return
           │    │
090        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
090        │    │                       ; Subroutine Name: read_tdc
           │    │                       ;
090        │    │                       ; Reads a 24-bit register from the TDC7200
           │    │                       ;
090        │    │                       ; When we enter, addr_reg should contain the register we
090        │    │                       ; want to read from, either TIME1, TIME2, CALIBRATION1,
090        │    │                       ; or CALIBRATION2
           │    │                       ;
090        │    │                       ; Takes a total of 32 clock pulses to do the read
090        │    │                       ; First 8 loads the register address and then last 24
090        │    │                       ; clocks read out the data
090        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │    │
090  20052 ╭──────▶           read_tdc: call clr_tdc_reg               ; clears all 24-bits of tdc_reg
           │    │
091        │    │                       ; Load address information and write to TDC_DATA_PORT
           │    │
091  2DD03 │    │                       output addr_reg, TDC_DATA_PORT
           │    │
092        │    │                       ; Assert ld[2] control (most significant byte of tdc register)
092        │    │                       ; Load address of register into ms byte of tdc_reg
092        │    │                       ; Synchronous load so we need to apply clock pulse
           │    │
092  05B04 │    │                       or tdc_ctl_reg, 04             ; Set bit 2
093  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
094  2004D ╰──────⤙                     call tdc_reg_clk
095  03BFB │    │                       and tdc_ctl_reg, fb            ; Clear bit 2
096  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
           │    │
097        │    │                       ; Bring tdc_csb pin low (active)
           │    │
097  20058 ╰──────⤙                     call tdc_csb_low
           │    │
098        │    │                       ; Load cnt register with the number of clock pulses
098        │    │                       ; It takes 8 clock pulses to load the register address (with write bit set)
098        │    │                       ; and then 24 clocks to read the data so a total of 32 clock pulse
           │    │
098  01420 │    │                       load cnt, 32'd
           │    │
099        │    │                       ; Call our TDC serial routine
           │    │
099  20083 │    ╰─⤙                     call tdc_serial
           │
09A        │                            ; Bring tdc_csb pin high (inactive)
           │
09A  2005B ╰──────⤙                     call tdc_csb_high
           │
09B  25000 │                            return
           │
09C        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
09C        │                            ; Subroutine Name: wait_rdy
09C        │                            ; We wait for tstamp_rdy to go high before we return
09C        │                            ; scr0 is used but not saved or restored
09C        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
09C  09204 ╭────┬┬▶           wait_rdy: input scr0, RDY_IPORT
09D  0D201 │    ││                      test scr0, 01                  ; Test bit 0
09E  3609C │    │╰⤙                     jump NZ, wait_rdy
09F  25000 │    │                       return
           │    │
0A0        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0A0        │    │                       ; Subroutine Name: time_to_fifo
           │    │                       ;
0A0        │    │                       ; Routine sends time related data to the FIFO
           │    │                       ;
0A0        │    │                       ;	constant	TSTAMP_LOWER_TAG, 40
0A0        │    │                       ;	constant	TSTAMP_UPPER_TAG, 50
           │    │
0A0        │    │                       ;	constant	TDC_TIME1_TAG, 90
0A0        │    │                       ;	constant	TDC_TIME2_TAG, a0
0A0        │    │                       ;	constant	TDC_CAL1_TAG, d0
0A0        │    │                       ;	constant	TDC_CAL2_TAG, e0
           │    │                       ;
0A0        │    │                       ; PORT 7 (MISC_OPORT)
           │    │                       ;
0A0        │    │                       ; 0 	force_psd_reset
0A0        │    │                       ; 1		veto_reset
0A0        │    │                       ; 2		fifo_mux_sel[0]
0A0        │    │                       ; 3		fifo_mux_sel[1]
0A0        │    │                       ; 4		psd_glob_ena
           │    │                       ;
0A0        │    │                       ; fifo_mux_sel = 00 -> adc_data (adc_reg)
0A0        │    │                       ; fifo_mux_sel = 01 -> tdc_data (tdc_reg)
0A0        │    │                       ; fifo_mux_sel = 10 -> tstamp counter (lower)
0A0        │    │                       ; fifo_mux_sel = 11 -> tstamp counter (upper)
           │    │                       ;
0A0        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │    │
0A0        │    │         time_to_fifo:
           │    │
0A0        │    │                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0A0        │    │                       ; Wait for TDC7200 tstamp_rdy to go low
0A0        │    │                       ; Can’t read registers until tstamp_rdy is high!
0A0        │    │                       ; tstamp_rdy is bit 0 of the RDY_IPORT
           │    │                       ;
0A0        │    │                       ; GLE: 15-Nov-2025
0A0        │    │                       ; Modified so all boards send timestamp counter
0A0        │    │                       ; value back!
0A0        │    │                       ; Board0 0 also sends TDC7200 data
0A0        │    │                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │    │
0A0        │    │                       ; Wait tfor the tstamp_rdy signal to go high
0A0        │    │                       ; Once it goes high, we know that the timestamp
0A0        │    │                       ; counter has been transferred to holding register
           │    │
0A0  2009C ╭────┴─▶                     call wait_rdy
           │
0A1        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0A1        │                            ; Send tstamp_counter (lower 24 bits)
0A1        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │
0A1  01040 │                            load op, TSTAMP_LOWER_TAG
0A2  2D002 │                            output op, DATA_TAG_PORT
           │
0A3        │                            ; Set the fifo_mux_sel to 10
           │
0A3  05C08 │                            or misc_oport_reg, 08          ; Set bit 3
0A4  03CFB │                            and misc_oport_reg, fb         ; Clear bit 2
0A5  2DC07 │                            output misc_oport_reg, MISC_OPORT
           │
0A6        │                            ; Wait for FIFO to be ready (bit 0 is tready)
           │
0A6  09100 │     ╭▶             .wait0: input ip, STATUS_IPORT
0A7  0D101 │     │                      test ip, 01                    ; Test bit 0
0A8  320A6 │     ╰⤙                     jump Z, .wait0
0A9  2D2FE │                            output scr0, VALID_PORT
           │
0AA        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0AA        │                            ; Send tstamp counter (upper 24 bits)
0AA        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │
0AA  01050 │                            load op, TSTAMP_UPPER_TAG
0AB  2D002 │                            output op, DATA_TAG_PORT
           │
0AC        │                            ; Set the fifo_mux_sel to 11 (it was 10)
           │
0AC  05C04 │                            or misc_oport_reg, 04          ; Set bit 2
0AD  2DC07 │                            output misc_oport_reg, MISC_OPORT
           │
0AE        │                            ; Check to see if we are board 0 or not
           │
0AE  0B200 │                            fetch scr0, BOARD_ID
0AF  1D200 │                            compare scr0, 00
0B0  320B6 │    ╭─⤙                     jump Z, .board0
           │    │
0B1        │    │                       ; If we are NOT board 0
0B1        │    │                       ; Wait for FIFO to be ready
0B1        │    │                       ; and then send tvalid/tlast
0B1        │    │                       ; Then return!
0B1        │    │                       ; So all boards send the timestamp counter back but
0B1        │    │                       ; if board is 0 then ALSO send the TDC7200 data!
           │    │
0B1  09100 │    │╭▶             .wait1: input ip, STATUS_IPORT
0B2  0D101 │    ││                      test ip, 01                    ; Test bit 0
0B3  320B1 │    │╰⤙                     jump Z, .wait1
