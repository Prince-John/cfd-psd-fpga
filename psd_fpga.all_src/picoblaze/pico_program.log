0E1        │                            ; Subroutine Name: adc_conv
           │                            ;
0E1        │                            ; Pass in adc_clk_mask and adc_conv_mask
0E1        │                            ; clk_0 is bit 0 of adc_clk_mask
0E1        │                            ; clk_1 is bit 1 of adc_clk_mask
0E1        │                            ; conv_0 is bit 2 of adc_conv_mask
0E1        │                            ; conv_1 is bit 3 of adc_conv_maks
           │                            ;
0E1        │                            ; Uses the cnt register to count clock pulses (16 bit ADC)
0E1        │                            ; but restores cnt register before returning!!!
0E1        │                            ; Use adc_reg but we don’t restore it
           │                            ;
0E1        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
0E1        │                  adc_conv:
           │
0E1        │                            ; Save cnt register
           │
