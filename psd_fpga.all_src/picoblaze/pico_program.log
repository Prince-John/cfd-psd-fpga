0EA        │                            ; Subroutine Name: adc_conv
           │                            ;
0EA        │                            ; Pass in adc_clk_mask and adc_conv_mask
0EA        │                            ; clk_0 is bit 0 of adc_clk_mask
0EA        │                            ; clk_1 is bit 1 of adc_clk_mask
0EA        │                            ; conv_0 is bit 2 of adc_conv_mask
0EA        │                            ; conv_1 is bit 3 of adc_conv_maks
           │                            ;
0EA        │                            ; Uses the cnt register to count clock pulses (16 bit ADC)
0EA        │                            ; but restores cnt register before returning!!!
0EA        │                            ; Use adc_reg but we don’t restore it
