062        ││                           ; $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
062        ││                           ; Collection of support routines for timestamp creation.
           ││                           ;
062        ││                           ; We will used tdc_ctl_reg to keep state
062        ││                           ; of the TDC_CTL_PORT
           ││                           ;
062        ││                           ; --------------------------------
062        ││                           ; PORT 4 (TDC register control)
062        ││                           ; --------------------------------
062        ││                           ; 0		tdc_reg_ld_0
062        ││                           ; 1		tdc_reg_ld_1
062        ││                           ; 2		tdc_reg_ld_2
062        ││                           ; 3		tdc_reg_rst
062        ││                           ; 4		tdc_reg_shift
062        ││                           ; 5		tdc_reg_sclk
062        ││                           ; 6		tdc_csb
062        ││                           ; 7		tdc_enable
062        ││                           ; $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
           ││
062        ││                           ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
062        ││                           ; Subroutine Name: tdc_reg_clk
           ││                           ;
062        ││                           ; Routine to apply a single clock pulse to tdc_reg
062        ││                           ; Doesn’t effect TDC7200 because tdc_csb should be high
062        ││                           ; when we apply the single clock pulse.  Pulse is needed
062        ││                           ; for synchronous reset and sychronous load of tdc_reg
062        ││                           ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││
062  05B20 ╭─┬───┬▶        tdc_reg_clk: or tdc_ctl_reg, 20             ; Set bit 5
063  2DB04 │││   │                      output tdc_ctl_reg, TDC_CTL_PORT ; clk high
064  03BDF │││   │                      and tdc_ctl_reg, df            ; Clear bit 5
065  2DB04 │││   │                      output tdc_ctl_reg, TDC_CTL_PORT ; clk low
066  25000 │││   │                      return
           │││   │
067        │││   │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
067        │││   │                      ; Subroutine Name: clr_tdc_reg
           │││   │                      ;
067        │││   │                      ; Clears the tdc register in our timstamp_interface module
067        │││   │                      ; The clear (bit 3) is synchronous so we need to apply a clock pulse
           │││   │                      ;
067        │││   │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │││   │
067  05B08 ╭────┬─▶        clr_tdc_reg: or tdc_ctl_reg, 08             ; Set bit 3
068  2DB04 │││  ││                      output tdc_ctl_reg, TDC_CTL_PORT
069  20062 │││  │╰⤙                     call tdc_reg_clk
06A  03BF7 │││  │                       and tdc_ctl_reg, f7            ; Clear bit 3
06B  2DB04 │││  │                       output tdc_ctl_reg, TDC_CTL_PORT
06C  25000 │││  │                       return
           │││  │
06D        │││  │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
06D        │││  │                       ; Subroutine Name: tdc_csb_low
           │││  │                       ;
06D        │││  │                       ; Bring TDC7200 csb pin low (bit 6 of TDC_CTL_PORT)
06D        │││  │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │││  │
06D  03BBF ╭───┬──▶        tdc_csb_low: and tdc_ctl_reg, bf            ; Clear bit 6
06E  2DB04 │││ ││                       output tdc_ctl_reg, TDC_CTL_PORT
06F  25000 │││ ││                       return
           │││ ││
           │││ ││                       ;
070        │││ ││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
070        │││ ││                       ; Subroutine Name: tdc_csb_high
           │││ ││                       ;
070        │││ ││                       ; Bring TDC7200 CSB pin high (bit 6 of TDC_CTL_PORT)
070        │││ ││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │││ ││
070  05B40 ╭──┬───▶       tdc_csb_high: or tdc_ctl_reg, 40             ; Set bit 6
071  2DB04 ││││││                       output tdc_ctl_reg, TDC_CTL_PORT
072  25000 ││││││                       return
           ││││││
           ││││││
073        ││││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
073        ││││││                       ; Subroutine Name: tdc_ena
           ││││││                       ;
073        ││││││                       ; This routine will enable the TDC7200
073        ││││││                       ; We do this by bringing the tdc_enable (Bit 7) low
073        ││││││                       ; and then bring it high. Enable must be high
073        ││││││                       ; for TDC7200 to perform conversions.
           ││││││                       ;
073        ││││││                       ; GLE: 8-Nov-2025 (added two more dly_us calls)
           ││││││                       ;
073        ││││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││││││
073  03B7F ╰──────▶            tdc_ena: and tdc_ctl_reg, 7f            ; Clear bit 7
074  2DB04 ││││││                       output tdc_ctl_reg, TDC_CTL_PORT
075  20038 ╰──────⤙                     call dly_1ms
076  05B80 ││││││                       or tdc_ctl_reg, 80             ; Set bit 7
077  2DB04 ││││││                       output tdc_ctl_reg, TDC_CTL_PORT
078  2004D │╰─────⤙                     call dly_100ms
079        │ ││││                       ; Added delay after enable transistion to wait for TDC7200 to stabilize - Prince Nov 22’26
079  25000 │ ││││                       return
           │ ││││
07A        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
07A        │ ││││                       ; Subroutine Name: config_tdc
           │ ││││                       ;
07A        │ ││││                       ; When we enter, addr_reg should contain the configuration
07A        │ ││││                       ; register address we want to load, either CONFGI1 or CONFIG2
           │ ││││                       ;
07A        │ ││││                       ; Also, when we enter, op register should contain the
07A        │ ││││                       ; configuration value, either CONFIG1_VAL or CONFIG2_VAL
           │ ││││                       ;
07A        │ ││││                       ; Loads the TDC7200 CONFIG1 or CONFIG2 register
07A        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │ ││││
07A  20067 │╭───┴┬▶         config_tdc: call clr_tdc_reg
           │││││ │
07B        │││││ │                      ; Load address information and write to TDC_DATA_PORT
07B        │││││ │                      ; addr_reg is passed into routine and contains address
07B        │││││ │                      ; of TDC7200 register we want to load!
           │││││ │
07B  2DD03 │││││ │                      output addr_reg, TDC_DATA_PORT
           │││││ │
07C        │││││ │                      ; Assert ld[2] control (most significant byte of tdc register)
07C        │││││ │                      ; Synchronous load so we need to apply a clock pulse!
07C        │││││ │                      ; ld[2] is bit 2 of the TDC_CTL_PORT
           │││││ │
07C  05B04 │││││ │                      or tdc_ctl_reg, 04             ; Set bit 2
07D  2DB04 │││││ │                      output tdc_ctl_reg, TDC_CTL_PORT
07E  20062 ││╰────⤙                     call tdc_reg_clk
07F  03BFB ││ ││ │                      and tdc_ctl_reg, fb            ; Clear bit 2
080  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
081        ││ ││ │                      ; Write value to TDC_DATA_PORT
081        ││ ││ │                      ; The op register is passed into routine and contains the data value
           ││ ││ │
081  2D003 ││ ││ │                      output op, TDC_DATA_PORT
           ││ ││ │
082        ││ ││ │                      ; Assert ld[1] control (middle byte of tdc register)
082        ││ ││ │                      ; ld[1] is bit 1 of TDC_CTL_PORT
           ││ ││ │
082  05B02 ││ ││ │                      or tdc_ctl_reg, 02             ; Set bit 1
083  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
084  20062 ╰──────⤙                     call tdc_reg_clk
085  03BFD ││ ││ │                      and tdc_ctl_reg, fd            ; Clear bit 1
086  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
087        ││ ││ │                      ; Bring tdc_csb pin low (active)
           ││ ││ │
087  2006D ││ │╰──⤙                     call tdc_csb_low
           ││ │  │
088        ││ │  │                      ; Load cnt with the number of clock pulses we want i.e. 16
088        ││ │  │                      ; We need 8 clocks to load register address and 8 to load the value
088        ││ │  │                      ; Address goes in first followed by data
           ││ │  │
088  01410 ││ │  │                      load cnt, 16'd
           ││ │  │
089        ││ │  │                      ; Call our TDC serial routine
           ││ │  │
089  20097 ││ │╭──⤙                     call tdc_serial
           ││ ││ │
08A        ││ ││ │                      ; Bring tdc_csb pin high (inactive)
           ││ ││ │
08A  20070 ││ ╰───⤙                     call tdc_csb_high
           ││  │ │
08B  25000 ││  │ │                      return
           ││  │ │
08C        ││  │ │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
08C        ││  │ │                      ; Subroutine Name: tdc_init
           ││  │ │                      ;
08C        ││  │ │                      ; Routine to initialize the TDC7200 and related circuits
08C        ││  │ │                      ; --> Load the CONFIG2 register
08C        ││  │ │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││  │ │
08C        ││  │ │            tdc_init:
           ││  │ │
08C        ││  │ │                      ; Load config data into CONFIG2 register
08C        ││  │ │                      ; This only needs to be done once!!!!!
08C        ││  │ │                      ; addr_reg needs to be loaded with address
08C        ││  │ │                      ; op needs to be loaded with value to be stored at address
           ││  │ │
08C  01D41 ╰──────▶                     load addr_reg, CONFIG2
08D  01001 ││  │ │                      load op, CONFIG2_VAL
08E  2007A ││  │ ╰⤙                     call config_tdc
08F  25000 ││  │                        return
           ││  │
090        ││  │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
090        ││  │                        ; Subroutine Name: start_tdc
           ││  │                        ;
090        ││  │                        ; This routine will start a measurement on TDC7200
090        ││  │                        ; Only starts if this is board 0!
           ││  │                        ;
090        ││  │                        ; Measurements are started by writing to CONFIG1 with
090        ││  │                        ; the least significant bit set!
           ││  │                        ;
090        ││  │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││  │
090        ││  │             start_tdc:
           ││  │
090        ││  │                        ; If this is board 0 then start the TDC
           ││  │
090  0B200 ╭──────▶                     fetch scr0, BOARD_ID
091  1D200 ││  │                        compare scr0, 00
092  36096 ││  │ ╭⤙                     jump NZ, .done
           ││  │ │
093        ││  │ │                      ; We start the TDC7200 by writing to CONFIG1
           ││  │ │
093  01D40 ││  │ │                      load addr_reg, CONFIG1
094  01001 ││  │ │                      load op, CONFIG1_VAL
095  2007A │╰─────⤙                     call config_tdc
           │   │ │
096  25000 │   │ ╰▶              .done: return
           │   │
097        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
097        │   │                        ; Subroutine Name: tdc_serial
           │   │                        ;
097        │   │                        ; Routine to send and receive serial dataa
097        │   │                        ; from TDC7200. Used to send both internal
097        │   │                        ; register address and data to the TDC7200
           │   │                        ;
097        │   │                        ; We should enter with cnt register containing
097        │   │                        ; number of clock pulses we want
           │   │                        ;
097        │   │                        ; Make sure the tdc_csb is LOW when this routine
097        │   │                        ; is called!
           │   │                        ;
097        │   │                        ; Minimum sclk period for the TDC7200 is 50 ns
           │   │                        ;
097        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │   │
097        │   │            tdc_serial:
           │   │
097        │   │                        ; Bring the shift control on tdc register high!
           │   │
097  05B10 │  ╭┴┬─▶                     or tdc_ctl_reg, 10             ; Set bit 4
098  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
           │  │ │
099        │  │ │                       ; Apply clock pulses (number in cnt register)
099        │  │ │                       ; Use scr0 as a clock mask (tdc_sclk is bit 5)
           │  │ │
099  01200 │  │ │                       load scr0, 00
09A  05220 │  │ │                       or scr0, 20                    ; Set bit 5
09B  06B20 │  │ │╭▶          .clk_loop: xor tdc_ctl_reg, scr0
09C  2DB04 │  │ ││                      output tdc_ctl_reg, TDC_CTL_PORT
09D        │  │ ││                      ;			nop
09D        │  │ ││                      ;			nop
09D  06B20 │  │ ││                      xor tdc_ctl_reg, scr0
09E  2DB04 │  │ ││                      output tdc_ctl_reg, TDC_CTL_PORT
09F  19401 │  │ ││                      sub cnt, 01
0A0  3609B │  │ │╰⤙                     jump NZ, .clk_loop
           │  │ │
0A1        │  │ │                       ; Bring the shift control on tdc register low!
           │  │ │
0A1  03BEF │  │ │                       and tdc_ctl_reg, ef            ; Clear bit 4
0A2  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
           │  │ │
0A3  25000 │  │ │                       return
           │  │ │
           │  │ │
0A4        │  │ │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0A4        │  │ │                       ; Subroutine Name: read_tdc_8
           │  │ │                       ;
0A4        │  │ │                       ; Reads a 8-bit register from the TDC7200
           │  │ │                       ;
