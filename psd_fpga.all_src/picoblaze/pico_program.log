176        │                            ; Turn led[0] on (On while we wait for take_event to go high!)
           │
176  05A01 │    ╭─▶              .loop: or led_reg, 01                 ; Set bit 0
177  2DA00 │    │                       output led_reg, LED_PORT
           │    │
178        │    │                       ; Wait for take_event to go HIGH
178        │    │                       ; Take event is bit 1 of the STATUS_IPORT
           │    │
178  09100 │    │╭▶             .wait0: input ip, STATUS_IPORT
179  0D102 │    ││                      test ip, 02                    ; Test bit 1
17A  32178 │    │╰⤙                     jump Z, .wait0
           │    │
