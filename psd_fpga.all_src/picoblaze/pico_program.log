05B        │││ ││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │││ ││
05B  05B40 ╭──┬───▶       tdc_csb_high: or tdc_ctl_reg, 40             ; Set bit 6
05C  2DB04 ││││││                       output tdc_ctl_reg, TDC_CTL_PORT
05D  25000 ││││││                       return
           ││││││
