           ││││││
05E  03B7F ╰──────▶            tdc_ena: and tdc_ctl_reg, 7f            ; Clear bit 7
05F  2DB04 ││││││                       output tdc_ctl_reg, TDC_CTL_PORT
060  20034 │╰─────⤙                     call dly_us
061  20034 ╰──────⤙                     call dly_us
062  20034 ╰──────⤙                     call dly_us
063  05B80 │ ││││                       or tdc_ctl_reg, 80             ; Set bit 7
064  2DB04 │ ││││                       output tdc_ctl_reg, TDC_CTL_PORT
