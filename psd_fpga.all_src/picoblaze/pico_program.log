0A4        │  │ │                       ; want to read from
0A4        │  │ │                       ; Takes a total of 16 clock pulses to do the read
0A4        │  │ │                       ; First 8 loads the register address and then last 8
0A4        │  │ │                       ; clocks read out the data
0A4        │  │ │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0A4  20067 ╰──────⤙         read_tdc_8: call clr_tdc_reg               ; clears all 24-bits of tdc_reg
           │  │ │
0A5  2DD03 │  │ │                       output addr_reg, TDC_DATA_PORT
           │  │ │
           │  │ │
0A6        │  │ │                       ; Assert ld[2] control (most significant byte of tdc register)
0A6        │  │ │                       ; Load address of register into ms byte of tdc_reg
0A6        │  │ │                       ; Synchronous load so we need to apply clock pulse
           │  │ │
0A6  05B04 │  │ │                       or tdc_ctl_reg, 04             ; Set bit 2
0A7  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
0A8  20062 ╰──────⤙                     call tdc_reg_clk
0A9  03BFB │  │ │                       and tdc_ctl_reg, fb            ; Clear bit 2
0AA  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
           │  │ │
0AB        │  │ │                       ; Bring tdc_csb pin low (active)
0AB  2006D ╰──────⤙                     call tdc_csb_low
           │  │ │
0AC        │  │ │                       ; Load cnt with the number of clock pulses we want i.e. 16
0AC        │  │ │                       ; We need 8 clocks to load register address and 8 to load the value
0AC        │  │ │                       ; Address goes in first followed by data
           │  │ │
0AC  01410 │  │ │                       load cnt, 16'd
           │  │ │
0AD        │  │ │                       ; Call our TDC serial routine
           │  │ │
0AD  20097 │  │ ╰─⤙                     call tdc_serial
           │  │
0AE        │  │                         ; Bring tdc_csb pin high (inactive)
           │  │
0AE  20070 ╰──────⤙                     call tdc_csb_high
           │  │
0AF  25000 │  │                         return
           │  │
           │  │
           │  │
           │  │
0B0        │  │                         ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0B0        │  │                         ; Subroutine Name: read_tdc
           │  │                         ;
0B0        │  │                         ; Reads a 24-bit register from the TDC7200
           │  │                         ;
0B0        │  │                         ; When we enter, addr_reg should contain the register we
0B0        │  │                         ; want to read from, either TIME1, TIME2, CALIBRATION1,
0B0        │  │                         ; or CALIBRATION2
           │  │                         ;
0B0        │  │                         ; Takes a total of 32 clock pulses to do the read
0B0        │  │                         ; First 8 loads the register address and then last 24
0B0        │  │                         ; clocks read out the data
0B0        │  │                         ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │  │
0B0  20067 ╭──────▶           read_tdc: call clr_tdc_reg               ; clears all 24-bits of tdc_reg
           │  │
0B1        │  │                         ; Load address information and write to TDC_DATA_PORT
           │  │
0B1  2DD03 │  │                         output addr_reg, TDC_DATA_PORT
           │  │
0B2        │  │                         ; Assert ld[2] control (most significant byte of tdc register)
0B2        │  │                         ; Load address of register into ms byte of tdc_reg
0B2        │  │                         ; Synchronous load so we need to apply clock pulse
           │  │
0B2  05B04 │  │                         or tdc_ctl_reg, 04             ; Set bit 2
0B3  2DB04 │  │                         output tdc_ctl_reg, TDC_CTL_PORT
0B4  20062 ╰──────⤙                     call tdc_reg_clk
0B5  03BFB │  │                         and tdc_ctl_reg, fb            ; Clear bit 2
0B6  2DB04 │  │                         output tdc_ctl_reg, TDC_CTL_PORT
           │  │
0B7        │  │                         ; Bring tdc_csb pin low (active)
           │  │
0B7  2006D ╰──────⤙                     call tdc_csb_low
           │  │
0B8        │  │                         ; Load cnt register with the number of clock pulses
0B8        │  │                         ; It takes 8 clock pulses to load the register address (with write bit set)
0B8        │  │                         ; and then 24 clocks to read the data so a total of 32 clock pulse
           │  │
0B8  01420 │  │                         load cnt, 32'd
           │  │
0B9        │  │                         ; Call our TDC serial routine
           │  │
0B9  20097 │  ╰───⤙                     call tdc_serial
           │
0BA        │                            ; Bring tdc_csb pin high (inactive)
