0F1        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0F1        │                            ; Name: adc_to_fifo
           │                            ;
0F1        │                            ; Each time this routine is called, it sends the A, B, C, T
0F1        │                            ; adc values to the microblaze FIFO
0F1        │                            ; ip will be used ...should contain PSDx_IPORT (x = 0 or 1)
           │                            ;
0F1        │                            ; Tag format:
           │                            ;
0F1        │                            ; 0		psd addr bit 0
0F1        │                            ; 1		psd addr bit 1
0F1        │                            ; 2		psd addr bit 2
0F1        │                            ; 3		psd addr bit 3 n(0 = PSD 0, 1 = PSD 1)
0F1        │                            ; 4		bit 0 of sc
0F1        │                            ; 5		bit 1 of sc
0F1        │                            ; 6		bit 0 of type
0F1        │                            ; 7		bit 1 of type
           │
0F1        │                            ; type = 00 ---> ADC data
0F1        │                            ; type = 01 ---> Timestamp Counter
0F1        │                            ; type = 10 ---> TDC TIME1 or TIME 2 value
0F1        │                            ; type = 11 ---> TDC CALIBRATION1 or CALIBRATION2 value
           │
0F1        │                            ; sc = 00 -----> integrator A
0F1        │                            ; sc = 01 -----> integrator B
0F1        │                            ; sc = 10 -----> integrator C
0F1        │                            ; sc = 11 -----> time
0F1        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
0F1        │               adc_to_fifo:
           │                            ;
0F1        │                            ; When we enter the routine, ip should contain PSD0 or PSD1 IPORT
0F1        │                            ; addr_reg will be used ...should contain PSDx_IPORT (x = 0 or 1)
0F1        │                            ; Here is the bit map
0F1        │                            ; NOTE: bit 6 tells us if it is PSD 0 or PSD1
           │                            ;
0F1        │                            ; 0		psd0_or
0F1        │                            ; 1		psd0_token_out
0F1        │                            ; 2		psd0_acq_ack
0F1        │                            ; 3		psd0_addr_out0
0F1        │                            ; 4		psd0_addr_out1
0F1        │                            ; 5		psd0_addr_out2
0F1        │                            ; 6     0 if PSD 0, 1 if PSD 1
0F1        │                            ; 7     0
           │
0F1        │                            ; Push some registers onto stack
           │
0F1  05A04 ╭──────▶                     or led_reg, 04                 ; Set bit 2  			;DEBUG FLAG 0 START
0F2  2DA00 │                            output led_reg, LED_PORT       ;DEBUG FLAG 0
           │
0F3  2E4F0 │                            store cnt, (SP)                ; Push
0F4  19F01 │                            sub SP, 01
           │
0F5  2E0F0 │                            store op, (SP)                 ; Push
0F6  19F01 │                            sub SP, 01
           │
0F7  2E1F0 │                            store ip, (SP)                 ; Push
0F8  19F01 │                            sub SP, 01
           │
           │
0F9        │                            ; Shift right 3 places
0F9        │                            ; Lower nybble now contains the channel address (bit 3 is PSD ID)
0F9        │                            ; Upper nybble contains 4’b000
           │
0F9  14D0E │                            sr0 addr_reg
0FA  14D0E │                            sr0 addr_reg
0FB  14D0E │                            sr0 addr_reg
           │
           │
0FC        │                            ; Load cnt to keep track which output we are working on
0FC        │                            ; A, B, C, or T (00, 01, 10, 11)
           │
0FC  01400 │                            load cnt, 00
           │
0FD        │                            ; Use scr1 to keep track of which PSD chip (either 0 or 1)
0FD        │                            ; Inspect bit 3 of ip register to see if it is PSD 0 or PSD 1
           │
0FD  01300 │                            load scr1, 00                  ; PSD 0
0FE  0DD08 │                            test addr_reg, 08              ; Test bit 3
0FF  32101 │     ╭⤙                     jump Z, .loop
100  01301 │     │                      load scr1, 01                  ; PSD 1
           │     │
101        │     │                      ; We will write DATA_TAG_PORT first
101        │     │                      ; Format of the data tag byte :
101        │     │                      ; 	xxyyzzzz
101        │     │                      ; 	xx is type (00 = adc, 01 = tstamp, 10 = tdc time, 11 = tdc cal)
101        │     │                      ; 	For ADC, yy = sc (00 = A, 01 = B, 10 = C , 11 =T)
101        │     │                      ;	For tstamp_counter, yy -> 00 = lower 24 bits, 01 = upper 24 bits
101        │     │                      ;	For tdc time, yy = 01 -> TIME1, yy = 10 -> TIME2
101        │     │                      ;	For tdc calibration, yy = 01 = CALIBRATION1, yy = 10 -> CALIBRATION2
101        │     │                      ; 	zz = 4-bit channel address
           │     │
101  000D0 │    ╭┴▶              .loop: load op, addr_reg              ; Load channel address
102  00240 │    │                       load scr0, cnt                 ; Copy cnt (i.e. which analog output) to scr0
103  14206 │    │                       sl0 scr0
104  14206 │    │                       sl0 scr0
105  14206 │    │                       sl0 scr0
106  14206 │    │                       sl0 scr0
107        │    │                       ; Shift left 4 places
107  04020 │    │                       or op, scr0                    ; Combine with channel address
108  2D002 │    │                       output op, DATA_TAG_PORT       ; Put out our data tag (MSbyte of 32-bit word)
           │    │
109        │    │                       ; Now we will now write ADC_CTL_PORT
109        │    │                       ; We need to route out the appropriate ADC register to the FIFO using MUX (3 bits)
           │    │
109  00040 │    │                       load op, cnt                   ; cnt is either (00 = A, 01 = B, 10 = C, 11 = T)
10A  14006 │    │                       sl0 op
10B  14006 │    │                       sl0 op
10C  14006 │    │                       sl0 op
10D  14006 │    │                       sl0 op
10E        │    │                       ; Mux sel is bits 4, 5, 6 of the ADC_CTL_PORT
           │    │
           │    │
10E  0D301 │    │                       test scr1, 01                  ; Test bit 0				; Bit 6 is 0 if PSD 0
10F  32111 │    │╭⤙                     jump Z, .skip
110  05040 │    ││                      or op, 40                      ; Set bit 6				; Bit 6 is a 1 if PSD 1
           │    ││
           │    ││
111  2D001 │    │╰▶              .skip: output op, ADC_CTL_PORT
           │    │                       ;
112        │    │                       ; Correct input is now sitting on FIFO input
112        │    │                       ; Wait for ’tready’ signal to be active
           │    │                       ;
           │    │
112  09100 │    │╭▶         .wait_trdy: input ip, STATUS_IPORT
           │    ││
113        │    ││                      ; Test bit 0 of STATUS_PORT (i.e. tready) ... if zero we should wait
           │    ││
113  0D101 │    ││                      test ip, 01                    ; Test bit 0
114  32112 │    │╰⤙                     jump Z, .wait_trdy
           │    │
           │    │
115        │    │                       ; When FIFO is ready, send data (what we send to vaild port makes no diff) --Prince: How do we know that the data is ready and stable?
           │    │
115  2D0FE │    │                       output op, VALID_PORT
           │    │
116        │    │                       ; Check to see if we are done sending A, B, C, T
116        │    │                       ; When cnt is equal to 4, we are done!
           │    │
116  11401 │    │                       add cnt, 01
117  1D404 │    │                       compare cnt, 04
118  36101 │    ╰─⤙                     jump NZ, .loop
           │
119        │                            ; Retrieve registers from stack
           │
119  11F01 │                            add SP, 01                     ; Pop
11A  0A1F0 │                            fetch ip, (SP)
           │
11B  11F01 │                            add SP, 01                     ; Pop
11C  0A0F0 │                            fetch op, (SP)
           │
11D  11F01 │                            add SP, 01                     ; Pop
11E  0A4F0 │                            fetch cnt, (SP)
           │
           │
11F  25000 │                            return
