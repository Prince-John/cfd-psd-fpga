09D        │  │                         ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
09D        │  │                         ; Subroutine Name: read_tdc
           │  │                         ;
09D        │  │                         ; Reads a 24-bit register from the TDC7200
           │  │                         ;
09D        │  │                         ; When we enter, addr_reg should contain the register we
09D        │  │                         ; want to read from, either TIME1, TIME2, CALIBRATION1,
09D        │  │                         ; or CALIBRATION2
           │  │                         ;
09D        │  │                         ; Takes a total of 32 clock pulses to do the read
09D        │  │                         ; First 8 loads the register address and then last 24
09D        │  │                         ; clocks read out the data
09D        │  │                         ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │  │
09D  20052 ╭──────▶           read_tdc: call clr_tdc_reg               ; clears all 24-bits of tdc_reg
           │  │
09E        │  │                         ; Load address information and write to TDC_DATA_PORT
           │  │
09E  2DD03 │  │                         output addr_reg, TDC_DATA_PORT
           │  │
09F        │  │                         ; Assert ld[2] control (most significant byte of tdc register)
09F        │  │                         ; Load address of register into ms byte of tdc_reg
09F        │  │                         ; Synchronous load so we need to apply clock pulse
           │  │
09F  05B04 │  │                         or tdc_ctl_reg, 04             ; Set bit 2
0A0  2DB04 │  │                         output tdc_ctl_reg, TDC_CTL_PORT
0A1  2004D ╰──────⤙                     call tdc_reg_clk
0A2  03BFB │  │                         and tdc_ctl_reg, fb            ; Clear bit 2
0A3  2DB04 │  │                         output tdc_ctl_reg, TDC_CTL_PORT
           │  │
0A4        │  │                         ; Bring tdc_csb pin low (active)
           │  │
0A4  20058 ╰──────⤙                     call tdc_csb_low
           │  │
0A5        │  │                         ; Load cnt register with the number of clock pulses
0A5        │  │                         ; It takes 8 clock pulses to load the register address (with write bit set)
0A5        │  │                         ; and then 24 clocks to read the data so a total of 32 clock pulse
           │  │
0A5  01420 │  │                         load cnt, 32'd
           │  │
0A6        │  │                         ; Call our TDC serial routine
           │  │
0A6  20084 │  ╰───⤙                     call tdc_serial
           │
0A7        │                            ; Bring tdc_csb pin high (inactive)
           │
0A7  2005B ╰──────⤙                     call tdc_csb_high
           │
0A8  25000 │                            return
           │
