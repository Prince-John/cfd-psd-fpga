0A2        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0A2        │   │                        ; Subroutine Name: time_to_fifo
           │   │                        ;
0A2        │   │                        ; Routine sends time related data to the FIFO
           │   │                        ;
0A2        │   │                        ;	constant	TSTAMP_LOWER_TAG, 40
0A2        │   │                        ;	constant	TSTAMP_UPPER_TAG, 50
0A2        │   │                        ; 	constant	NO_TSTAMP_TAG, FF
           │   │
0A2        │   │                        ;	constant	TDC_TIME1_TAG, 90
0A2        │   │                        ;	constant	TDC_TIME2_TAG, a0
0A2        │   │                        ;	constant	TDC_CAL1_TAG, d0
0A2        │   │                        ;	constant	TDC_CAL2_TAG, e0
           │   │                        ;
0A2        │   │                        ; PORT 7 (MISC_OPORT)
           │   │                        ;
0A2        │   │                        ; 0 	force_psd_reset
0A2        │   │                        ; 1		veto_reset
0A2        │   │                        ; 2		fifo_mux_sel[0]
0A2        │   │                        ; 3		fifo_mux_sel[1]
0A2        │   │                        ; 4		psd_glob_ena
           │   │                        ;
0A2        │   │                        ; fifo_mux_sel = 00 -> adc_data (adc_reg)
0A2        │   │                        ; fifo_mux_sel = 01 -> tdc_data (tdc_reg)
0A2        │   │                        ; fifo_mux_sel = 10 -> tstamp counter (lower)
0A2        │   │                        ; fifo_mux_sel = 11 -> tstamp counter (upper)
           │   │                        ;
0A2        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │   │
0A2        │   │          time_to_fifo:
           │   │
0A2        │   │                        ; Check to see if we are board 0 or not
           │   │
0A2  0B200 ╭──────▶                     fetch scr0, BOARD_ID
0A3  1D200 │   │                        compare scr0, 00
0A4  320AC │   │╭─⤙                     jump Z, .board0
           │   ││
0A5        │   ││                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0A5        │   ││                       ; Need to terminate the packet if we are not board 0
0A5        │   ││                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │   ││
0A5  010FF │   ││                       load op, NO_TSTAMP_TAG
0A6  2D002 │   ││                       output op, DATA_TAG_PORT
           │   ││
0A7        │   ││                       ; Wait for FIFO to be ready (bit 0 id tready)
0A7        │   ││                       ; We don’t care what the FIFO_MUX_SEL is set to
           │   ││
0A7  09100 │   ││╭▶             .tlast: input ip, STATUS_IPORT
0A8  0D101 │   │││                      test ip, 01                    ; Test bit 0
0A9  320A7 │   ││╰⤙                     jump Z, .tlast
0AA  2D2FF │   ││                       output scr0, LAST_PORT
0AB  25000 │   ││                       return
           │   ││
0AC        │   ││                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0AC        │   ││                       ; Wait for TDC7200 tstamp_rdy to go low
0AC        │   ││                       ; Can’t read registers until intb is low
0AC        │   ││                       ; tstamp_rdy is bit 0 of the RDY_IPORT
0AC        │   ││                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │   ││
0AC        │   ││              .board0:
0AC  2009C │   ╰┴─⤙                     call wait_rdy
           │
0AD        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0AD        │                            ; Send tstamp_counter (lower 24 bits)
0AD        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │
0AD  01040 │                            load op, TSTAMP_LOWER_TAG
0AE  2D002 │                            output op, DATA_TAG_PORT
           │
0AF        │                            ; Set the fifo_mux_sel to 10
           │
0AF  05C08 │                            or misc_oport_reg, 08          ; Set bit 3
0B0  03CFB │                            and misc_oport_reg, fb         ; Clear bit 2
0B1  2DC07 │                            output misc_oport_reg, MISC_OPORT
           │
0B2        │                            ; Wait for FIFO to be ready (bit 0 is tready)
           │
