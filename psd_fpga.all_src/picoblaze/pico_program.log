083        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
083        │   │                        ; Subroutine Name: tdc_serial
           │   │                        ;
083        │   │                        ; Routine to send and receive serial dataa
083        │   │                        ; from TDC7200. Used to send both internal
083        │   │                        ; register address and data to the TDC7200
           │   │                        ;
083        │   │                        ; We should enter with cnt register containing
083        │   │                        ; number of clock pulses we want
           │   │                        ;
083        │   │                        ; Make sure the tdc_csb is LOW when this routine
083        │   │                        ; is called!
           │   │                        ;
083        │   │                        ; Minimum sclk period for the TDC7200 is 50 ns
           │   │                        ;
083        │   │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │   │
083        │   │            tdc_serial:
           │   │
083        │   │                        ; Bring the shift control on tdc register high!
           │   │
083  05B10 │   ╰┬─▶                     or tdc_ctl_reg, 10             ; Set bit 4
084  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
           │    │
085        │    │                       ; Apply clock pulses (number in cnt register)
085        │    │                       ; Use scr0 as a clock mask (tdc_sclk is bit 5)
           │    │
085  01200 │    │                       load scr0, 00
086  05220 │    │                       or scr0, 20                    ; Set bit 5
087  06B20 │    │╭▶          .clk_loop: xor tdc_ctl_reg, scr0
088  2DB04 │    ││                      output tdc_ctl_reg, TDC_CTL_PORT
089        │    ││                      ;			nop
089        │    ││                      ;			nop
089  06B20 │    ││                      xor tdc_ctl_reg, scr0
08A  2DB04 │    ││                      output tdc_ctl_reg, TDC_CTL_PORT
08B  19401 │    ││                      sub cnt, 01
08C  36087 │    │╰⤙                     jump NZ, .clk_loop
           │    │
08D        │    │                       ; Bring the shift control on tdc register low!
           │    │
08D  03BEF │    │                       and tdc_ctl_reg, ef            ; Clear bit 4
08E  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
           │    │
08F  25000 │    │                       return
           │    │
090        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
090        │    │                       ; Subroutine Name: read_tdc
           │    │                       ;
090        │    │                       ; Reads a 24-bit register from the TDC7200
           │    │                       ;
090        │    │                       ; When we enter, addr_reg should contain the register we
090        │    │                       ; want to read from, either TIME1, TIME2, CALIBRATION1,
090        │    │                       ; or CALIBRATION2
           │    │                       ;
090        │    │                       ; Takes a total of 32 clock pulses to do the read
090        │    │                       ; First 8 loads the register address and then last 24
090        │    │                       ; clocks read out the data
090        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │    │
090  20052 ╭──────▶           read_tdc: call clr_tdc_reg               ; clears all 24-bits of tdc_reg
           │    │
091        │    │                       ; Load address information and write to TDC_DATA_PORT
           │    │
091  2DD03 │    │                       output addr_reg, TDC_DATA_PORT
           │    │
092        │    │                       ; Assert ld[2] control (most significant byte of tdc register)
092        │    │                       ; Load address of register into ms byte of tdc_reg
092        │    │                       ; Synchronous load so we need to apply clock pulse
           │    │
092  05B04 │    │                       or tdc_ctl_reg, 04             ; Set bit 2
093  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
094  2004D ╰──────⤙                     call tdc_reg_clk
095  03BFB │    │                       and tdc_ctl_reg, fb            ; Clear bit 2
096  2DB04 │    │                       output tdc_ctl_reg, TDC_CTL_PORT
           │    │
097        │    │                       ; Bring tdc_csb pin low (active)
           │    │
097  20058 ╰──────⤙                     call tdc_csb_low
           │    │
098        │    │                       ; Load cnt register with the number of clock pulses
098        │    │                       ; It takes 8 clock pulses to load the register address (with write bit set)
098        │    │                       ; and then 24 clocks to read the data so a total of 32 clock pulse
           │    │
098  01420 │    │                       load cnt, 32'd
           │    │
099        │    │                       ; Call our TDC serial routine
           │    │
099  20083 │    ╰─⤙                     call tdc_serial
           │
09A        │                            ; Bring tdc_csb pin high (inactive)
           │
09A  2005B ╰──────⤙                     call tdc_csb_high
           │
09B  25000 │                            return
           │
