126  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD0 OR
127  32129 ││ │  ╭⤙                     jump Z, .or0
128  05901 ││ │  │                      or psd_or_reg, 01              ; Set bit 0			; Make note that PSD0 OR is high
129  09103 ││ │  ╰▶               .or0: input ip, PSD1_IPORT
12A  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD1 OR
12B  3212D ││ │  ╭⤙                     jump Z, .or1
12C  05902 ││ │  │                      or psd_or_reg, 02              ; Set bit 1			; Make note that PSD1 OR is high
           ││ │  │                      ;
12D        ││ │  │                      ; Implement a case statement based on lower two bits of psd_or_reg
           ││ │  │                      ;
           ││ │  │
