078        ││  │ │                      ; Subroutine Name: tdc_init
           ││  │ │                      ;
078        ││  │ │                      ; Routine to initialize the TDC7200 and related circuits
078        ││  │ │                      ; --> Load the CONFIG2 register
078        ││  │ │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││  │ │
078        ││  │ │            tdc_init:
           ││  │ │
078        ││  │ │                      ; Load config data into CONFIG2 register
078        ││  │ │                      ; This only needs to be done once!!!!!
078        ││  │ │                      ; addr_reg needs to be loaded with address
078        ││  │ │                      ; op needs to be loaded with value to be stored at address
           ││  │ │
078  01D41 ╰──────▶                     load addr_reg, CONFIG2
079  01001 ││  │ │                      load op, CONFIG2_VAL
07A  20066 ││  │ ╰⤙                     call config_tdc
