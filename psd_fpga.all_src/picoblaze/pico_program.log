135  01600 ││ │                         load adc_reg, 00
           ││ │
136  09102 ││ │                         input ip, PSD0_IPORT
137  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD0 OR
138  3213A ││ │  ╭⤙                     jump Z, .or0
139  05901 ││ │  │                      or psd_or_reg, 01              ; Set bit 0			; Make note that PSD0 OR is high
13A  09103 ││ │  ╰▶               .or0: input ip, PSD1_IPORT
13B  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD1 OR
13C  3213E ││ │  ╭⤙                     jump Z, .or1
13D  05902 ││ │  │                      or psd_or_reg, 02              ; Set bit 1			; Make note that PSD1 OR is high
           ││ │  │                      ;
13E        ││ │  │                      ; Implement a case statement based on lower two bits of psd_or_reg
           ││ │  │                      ;
           ││ │  │
13E  1D900 ││ │  ╰▶               .or1: compare psd_or_reg, 00
13F  3217E ╭──────⤙                     jump Z, .done
140  1D901 ││ │                         compare psd_or_reg, 01
141  32147 ││ │ ╭─⤙                     jump Z, .psd0
142  1D902 ││ │ │                       compare psd_or_reg, 02
143  32157 ││ │╭──⤙                     jump Z, .psd1
