0E5        │                            ; Reading serial data out of the ADCs
0E5        │                            ; Clocked into shift registers in our custom block
           │
0E5  01410 │                            load cnt, 16'd
0E6  06670 │     ╭▶          .clk_loop: xor adc_reg, adc_clk_mask
0E7  2D601 │     │                      output adc_reg, ADC_CTL_PORT
0E8  06670 │     │                      xor adc_reg, adc_clk_mask
