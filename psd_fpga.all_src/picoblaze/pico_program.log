04D        ││                           ; Subroutine Name: tdc_reg_clk
           ││                           ;
04D        ││                           ; Routine to apply a single clock pulse to tdc_reg
04D        ││                           ; Doesn’t effect TDC7200 because tdc_csb should be high
04D        ││                           ; when we apply the single clock pulse.  Pulse is needed
04D        ││                           ; for synchronous reset and sychronous load of tdc_reg
04D        ││                           ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││
04D  05B20 ╭─┬───┬▶        tdc_reg_clk: or tdc_ctl_reg, 20             ; Set bit 5
04E  2DB04 │││   │                      output tdc_ctl_reg, TDC_CTL_PORT ; clk high
04F  03BDF │││   │                      and tdc_ctl_reg, df            ; Clear bit 5
050  2DB04 │││   │                      output tdc_ctl_reg, TDC_CTL_PORT ; clk low
051  25000 │││   │                      return
           │││   │
052        │││   │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
052        │││   │                      ; Subroutine Name: clr_tdc_reg
           │││   │                      ;
052        │││   │                      ; Clears the tdc register in our timstamp_interface module
052        │││   │                      ; The clear (bit 3) is synchronous so we need to apply a clock pulse
           │││   │                      ;
052        │││   │                      ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │││   │
052  05B08 ╭────┬─▶        clr_tdc_reg: or tdc_ctl_reg, 08             ; Set bit 3
053  2DB04 │││  ││                      output tdc_ctl_reg, TDC_CTL_PORT
054  2004D │││  │╰⤙                     call tdc_reg_clk
055  03BF7 │││  │                       and tdc_ctl_reg, f7            ; Clear bit 3
056  2DB04 │││  │                       output tdc_ctl_reg, TDC_CTL_PORT
057  25000 │││  │                       return
           │││  │
