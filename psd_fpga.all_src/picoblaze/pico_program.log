067        │ ││││                       ; Subroutine Name: config_tdc
           │ ││││                       ;
067        │ ││││                       ; When we enter, addr_reg should contain the configuration
067        │ ││││                       ; register address we want to load, either CONFGI1 or CONFIG2
           │ ││││                       ;
067        │ ││││                       ; Also, when we enter, op register should contain the
067        │ ││││                       ; configuration value, either CONFIG1_VAL or CONFIG2_VAL
           │ ││││                       ;
067        │ ││││                       ; Loads the TDC7200 CONFIG1 or CONFIG2 register
067        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │ ││││
067  20052 │╭───┴┬▶         config_tdc: call clr_tdc_reg
           │││││ │
068        │││││ │                      ; Load address information and write to TDC_DATA_PORT
068        │││││ │                      ; addr_reg is passed into routine and contains address
068        │││││ │                      ; of TDC7200 register we want to load!
           │││││ │
068  2DD03 │││││ │                      output addr_reg, TDC_DATA_PORT
           │││││ │
069        │││││ │                      ; Assert ld[2] control (most significant byte of tdc register)
069        │││││ │                      ; Synchronous load so we need to apply a clock pulse!
069        │││││ │                      ; ld[2] is bit 2 of the TDC_CTL_PORT
           │││││ │
069  05B04 │││││ │                      or tdc_ctl_reg, 04             ; Set bit 2
06A  2DB04 │││││ │                      output tdc_ctl_reg, TDC_CTL_PORT
06B  2004D ││╰────⤙                     call tdc_reg_clk
06C  03BFB ││ ││ │                      and tdc_ctl_reg, fb            ; Clear bit 2
06D  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
06E        ││ ││ │                      ; Write value to TDC_DATA_PORT
06E        ││ ││ │                      ; The op register is passed into routine and contains the data value
           ││ ││ │
06E  2D003 ││ ││ │                      output op, TDC_DATA_PORT
           ││ ││ │
06F        ││ ││ │                      ; Assert ld[1] control (middle byte of tdc register)
06F        ││ ││ │                      ; ld[1] is bit 1 of TDC_CTL_PORT
           ││ ││ │
06F  05B02 ││ ││ │                      or tdc_ctl_reg, 02             ; Set bit 1
070  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
071  2004D ╰──────⤙                     call tdc_reg_clk
072  03BFD ││ ││ │                      and tdc_ctl_reg, fd            ; Clear bit 1
073  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
074        ││ ││ │                      ; Bring tdc_csb pin low (active)
           ││ ││ │
074  20058 ││ │╰──⤙                     call tdc_csb_low
           ││ │  │
075        ││ │  │                      ; Load cnt with the number of clock pulses we want i.e. 16
075        ││ │  │                      ; We need 8 clocks to load register address and 8 to load the value
075        ││ │  │                      ; Address goes in first followed by data
           ││ │  │
075  01410 ││ │  │                      load cnt, 16'd
           ││ │  │
076        ││ │  │                      ; Call our TDC serial routine
           ││ │  │
076  20084 ││ │╭──⤙                     call tdc_serial
           ││ ││ │
077        ││ ││ │                      ; Bring tdc_csb pin high (inactive)
           ││ ││ │
077  2005B ││ ╰───⤙                     call tdc_csb_high
           ││  │ │
078  25000 ││  │ │                      return
