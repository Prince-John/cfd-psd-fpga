0F4        │                            ; Clocked into shift registers in our custom block
           │
0F4  01410 │                            load cnt, 16'd
0F5  06670 │     ╭▶          .clk_loop: xor adc_reg, adc_clk_mask
0F6  2D601 │     │                      output adc_reg, ADC_CTL_PORT
0F7  06670 │     │                      xor adc_reg, adc_clk_mask
