07C        ││  │                        ; Subroutine Name: start_tdc
           ││  │                        ;
07C        ││  │                        ; This routine will start a measurement on TDC7200
07C        ││  │                        ; Only starts if this is board 0!
           ││  │                        ;
07C        ││  │                        ; Measurements are started by writing to CONFIG1 with
07C        ││  │                        ; the least significant bit set!
           ││  │                        ;
07C        ││  │                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           ││  │
07C        ││  │             start_tdc:
           ││  │
07C        ││  │                        ; If this is board 0 then start the TDC
           ││  │
07C  0B200 ╭──────▶                     fetch scr0, BOARD_ID
07D  1D200 ││  │                        compare scr0, 00
07E  36082 ││  │ ╭⤙                     jump NZ, .done
           ││  │ │
07F        ││  │ │                      ; We start the TDC7200 by writing to CONFIG1
           ││  │ │
07F  01D40 ││  │ │                      load addr_reg, CONFIG1
080  01001 ││  │ │                      load op, CONFIG1_VAL
081  20066 │╰─────⤙                     call config_tdc
           │   │ │
