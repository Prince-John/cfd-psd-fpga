091  20052 ╭──────▶         read_tdc_8: call clr_tdc_reg               ; clears all 24-bits of tdc_reg
           │  │ │
092  2DD03 │  │ │                       output addr_reg, TDC_DATA_PORT
           │  │ │
           │  │ │
093        │  │ │                       ; Assert ld[2] control (most significant byte of tdc register)
093        │  │ │                       ; Load address of register into ms byte of tdc_reg
093        │  │ │                       ; Synchronous load so we need to apply clock pulse
           │  │ │
093  05B04 │  │ │                       or tdc_ctl_reg, 04             ; Set bit 2
094  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
095  2004D ╰──────⤙                     call tdc_reg_clk
096  03BFB │  │ │                       and tdc_ctl_reg, fb            ; Clear bit 2
097  2DB04 │  │ │                       output tdc_ctl_reg, TDC_CTL_PORT
           │  │ │
098        │  │ │                       ; Bring tdc_csb pin low (active)
098  20058 ╰──────⤙                     call tdc_csb_low
           │  │ │
099        │  │ │                       ; Load cnt with the number of clock pulses we want i.e. 16
099        │  │ │                       ; We need 8 clocks to load register address and 8 to load the value
099        │  │ │                       ; Address goes in first followed by data
           │  │ │
099  01410 │  │ │                       load cnt, 16'd
           │  │ │
09A        │  │ │                       ; Call our TDC serial routine
           │  │ │
09A  20084 │  │ ╰─⤙                     call tdc_serial
           │  │
09B        │  │                         ; Bring tdc_csb pin high (inactive)
           │  │
09B  2005B ╰──────⤙                     call tdc_csb_high
           │  │
09C  25000 │  │                         return
