0E2  19F01 │                            sub SP, 01
           │
           │
0E3        │                            ; Bring conv signals high (determined by adc_conv_mask)
0E3        │                            ; The AD7687 ADCs sample PSD analog outputs on the rising
0E3        │                            ; edge of CONV signal
           │
0E3  20034 ╰──────⤙                     call dly_us                    ; DEBUG put in for ADC T Tail - Prince Sep 11
0E4  20034 ╰──────⤙                     call dly_us                    ;
0E5  00680 │                            load adc_reg, adc_conv_mask    ; Make CONV high
0E6  2D601 │                            output adc_reg, ADC_CTL_PORT
           │
0E7        │                            ; Wait for 2 usec
           │
0E7  20034 ╰──────⤙                     call dly_us
0E8  20034 ╰──────⤙                     call dly_us
           │
0E9        │                            ; Bring conv signals low
           │
0E9  06680 │                            xor adc_reg, adc_conv_mask
0EA  2D601 │                            output adc_reg, ADC_CTL_PORT
           │
0EB        │                            ; Apply 16 clock pulses (takes about 2 usec)
0EB        │                            ; Reading serial data out of the ADCs
0EB        │                            ; Clocked into shift registers in our custom block
           │
0EB  01410 │                            load cnt, 16'd
0EC  06670 │     ╭▶          .clk_loop: xor adc_reg, adc_clk_mask
0ED  2D601 │     │                      output adc_reg, ADC_CTL_PORT
0EE  06670 │     │                      xor adc_reg, adc_clk_mask
0EF  00EE0 │     │                      load se, se                    ; NOP
0F0  00EE0 │     │                      load se, se                    ; NOP
0F1  2D601 │     │                      output adc_reg, ADC_CTL_PORT
0F2  19401 │     │                      sub cnt, 01
0F3  360EC │     ╰⤙                     jump NZ, .clk_loop
           │
0F4        │                            ; Restore cnt register
           │
0F4  11F01 │                            add SP, 01                     ; Pop
0F5  0A4F0 │                            fetch cnt, (SP)
           │
           │
0F6  25000 │                            return
           │
0F7        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0F7        │                            ; Name: adc_to_fifo
           │                            ;
0F7        │                            ; Each time this routine is called, it sends the A, B, C, T
0F7        │                            ; adc values to the microblaze FIFO
0F7        │                            ; ip will be used ...should contain PSDx_IPORT (x = 0 or 1)
           │                            ;
0F7        │                            ; Tag format:
           │                            ;
0F7        │                            ; 0		psd addr bit 0
0F7        │                            ; 1		psd addr bit 1
0F7        │                            ; 2		psd addr bit 2
0F7        │                            ; 3		psd addr bit 3 n(0 = PSD 0, 1 = PSD 1)
0F7        │                            ; 4		bit 0 of sc
0F7        │                            ; 5		bit 1 of sc
0F7        │                            ; 6		bit 0 of type
0F7        │                            ; 7		bit 1 of type
           │
0F7        │                            ; type = 00 ---> ADC data
0F7        │                            ; type = 01 ---> Timestamp Counter
0F7        │                            ; type = 10 ---> TDC TIME1 or TIME 2 value
0F7        │                            ; type = 11 ---> TDC CALIBRATION1 or CALIBRATION2 value
           │
0F7        │                            ; sc = 00 -----> integrator A
0F7        │                            ; sc = 01 -----> integrator B
0F7        │                            ; sc = 10 -----> integrator C
0F7        │                            ; sc = 11 -----> time
0F7        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
0F7        │               adc_to_fifo:
           │                            ;
0F7        │                            ; When we enter the routine, ip should contain PSD0 or PSD1 IPORT
0F7        │                            ; addr_reg will be used ...should contain PSDx_IPORT (x = 0 or 1)
0F7        │                            ; Here is the bit map
0F7        │                            ; NOTE: bit 6 tells us if it is PSD 0 or PSD1
           │                            ;
0F7        │                            ; 0		psd0_or
0F7        │                            ; 1		psd0_token_out
0F7        │                            ; 2		psd0_acq_ack
0F7        │                            ; 3		psd0_addr_out0
0F7        │                            ; 4		psd0_addr_out1
0F7        │                            ; 5		psd0_addr_out2
0F7        │                            ; 6     0 if PSD 0, 1 if PSD 1
0F7        │                            ; 7     0
           │
0F7        │                            ; Push some registers onto stack
           │
0F7  05A04 ╭──────▶                     or led_reg, 04                 ; Set bit 2  			;DEBUG FLAG 0 START
0F8  2DA00 │                            output led_reg, LED_PORT       ;DEBUG FLAG 0
           │
0F9  2E4F0 │                            store cnt, (SP)                ; Push
0FA  19F01 │                            sub SP, 01
           │
0FB  2E0F0 │                            store op, (SP)                 ; Push
0FC  19F01 │                            sub SP, 01
           │
0FD  2E1F0 │                            store ip, (SP)                 ; Push
0FE  19F01 │                            sub SP, 01
           │
           │
0FF        │                            ; Shift right 3 places
0FF        │                            ; Lower nybble now contains the channel address (bit 3 is PSD ID)
0FF        │                            ; Upper nybble contains 4’b000
           │
0FF  14D0E │                            sr0 addr_reg
100  14D0E │                            sr0 addr_reg
101  14D0E │                            sr0 addr_reg
           │
           │
102        │                            ; Load cnt to keep track which output we are working on
102        │                            ; A, B, C, or T (00, 01, 10, 11)
           │
102  01400 │                            load cnt, 00
           │
103        │                            ; Use scr1 to keep track of which PSD chip (either 0 or 1)
103        │                            ; Inspect bit 3 of ip register to see if it is PSD 0 or PSD 1
           │
103  01300 │                            load scr1, 00                  ; PSD 0
104  0DD08 │                            test addr_reg, 08              ; Test bit 3
105  32107 │     ╭⤙                     jump Z, .loop
106  01301 │     │                      load scr1, 01                  ; PSD 1
           │     │
107        │     │                      ; We will write DATA_TAG_PORT first
107        │     │                      ; Format of the data tag byte :
107        │     │                      ; 	xxyyzzzz
107        │     │                      ; 	xx is type (00 = adc, 01 = tstamp, 10 = tdc time, 11 = tdc cal)
107        │     │                      ; 	For ADC, yy = sc (00 = A, 01 = B, 10 = C , 11 =T)
107        │     │                      ;	For tstamp_counter, yy -> 00 = lower 24 bits, 01 = upper 24 bits
107        │     │                      ;	For tdc time, yy = 01 -> TIME1, yy = 10 -> TIME2
107        │     │                      ;	For tdc calibration, yy = 01 = CALIBRATION1, yy = 10 -> CALIBRATION2
107        │     │                      ; 	zz = 4-bit channel address
           │     │
107  000D0 │    ╭┴▶              .loop: load op, addr_reg              ; Load channel address
108  00240 │    │                       load scr0, cnt                 ; Copy cnt (i.e. which analog output) to scr0
109  14206 │    │                       sl0 scr0
10A  14206 │    │                       sl0 scr0
10B  14206 │    │                       sl0 scr0
10C  14206 │    │                       sl0 scr0
10D        │    │                       ; Shift left 4 places
10D  04020 │    │                       or op, scr0                    ; Combine with channel address
10E  2D002 │    │                       output op, DATA_TAG_PORT       ; Put out our data tag (MSbyte of 32-bit word)
           │    │
10F        │    │                       ; Now we will now write ADC_CTL_PORT
10F        │    │                       ; We need to route out the appropriate ADC register to the FIFO using MUX (3 bits)
           │    │
10F  00040 │    │                       load op, cnt                   ; cnt is either (00 = A, 01 = B, 10 = C, 11 = T)
110  14006 │    │                       sl0 op
111  14006 │    │                       sl0 op
112  14006 │    │                       sl0 op
113  14006 │    │                       sl0 op
114        │    │                       ; Mux sel is bits 4, 5, 6 of the ADC_CTL_PORT
           │    │
           │    │
114  0D301 │    │                       test scr1, 01                  ; Test bit 0				; Bit 6 is 0 if PSD 0
115  32117 │    │╭⤙                     jump Z, .skip
116  05040 │    ││                      or op, 40                      ; Set bit 6				; Bit 6 is a 1 if PSD 1
           │    ││
           │    ││
117  2D001 │    │╰▶              .skip: output op, ADC_CTL_PORT
           │    │                       ;
118        │    │                       ; Correct input is now sitting on FIFO input
118        │    │                       ; Wait for ’tready’ signal to be active
           │    │                       ;
           │    │
118  09100 │    │╭▶         .wait_trdy: input ip, STATUS_IPORT
           │    ││
119        │    ││                      ; Test bit 0 of STATUS_PORT (i.e. tready) ... if zero we should wait
           │    ││
119  0D101 │    ││                      test ip, 01                    ; Test bit 0
11A  32118 │    │╰⤙                     jump Z, .wait_trdy
           │    │
           │    │
11B        │    │                       ; When FIFO is ready, send data (what we send to vaild port makes no diff) --Prince: How do we know that the data is ready and stable?
           │    │
11B  2D0FE │    │                       output op, VALID_PORT
           │    │
11C        │    │                       ; Check to see if we are done sending A, B, C, T
11C        │    │                       ; When cnt is equal to 4, we are done!
           │    │
11C  11401 │    │                       add cnt, 01
11D  1D404 │    │                       compare cnt, 04
11E  36107 │    ╰─⤙                     jump NZ, .loop
           │
11F        │                            ; Retrieve registers from stack
           │
11F  11F01 │                            add SP, 01                     ; Pop
120  0A1F0 │                            fetch ip, (SP)
           │
121  11F01 │                            add SP, 01                     ; Pop
122  0A0F0 │                            fetch op, (SP)
           │
123  11F01 │                            add SP, 01                     ; Pop
124  0A4F0 │                            fetch cnt, (SP)
           │
           │
125  25000 │                            return
           │
126        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
126        │                            ; Name: get_event
           │                            ;
126        │                            ; Routine to get a nuclear physics event
           │                            ;
126        │                            ; Aquires data from the 4 ADCS (A, B, C, T) for all hit channels on
126        │                            ; both PSD chips!
           │                            ;
