117        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
117        │                            ; Name: adc_to_fifo
           │                            ;
117        │                            ; Each time this routine is called, it sends the A, B, C, T
117        │                            ; adc values to the microblaze FIFO
117        │                            ; ip will be used ...should contain PSDx_IPORT (x = 0 or 1)
           │                            ;
117        │                            ; Tag format:
           │                            ;
117        │                            ; 0		psd addr bit 0
117        │                            ; 1		psd addr bit 1
117        │                            ; 2		psd addr bit 2
117        │                            ; 3		psd addr bit 3 n(0 = PSD 0, 1 = PSD 1)
117        │                            ; 4		bit 0 of sc
117        │                            ; 5		bit 1 of sc
117        │                            ; 6		bit 0 of type
117        │                            ; 7		bit 1 of type
           │
117        │                            ; type = 00 ---> ADC data
117        │                            ; type = 01 ---> Timestamp Counter
117        │                            ; type = 10 ---> TDC TIME1 or TIME 2 value
117        │                            ; type = 11 ---> TDC CALIBRATION1 or CALIBRATION2 value
           │
117        │                            ; sc = 00 -----> integrator A
117        │                            ; sc = 01 -----> integrator B
117        │                            ; sc = 10 -----> integrator C
117        │                            ; sc = 11 -----> time
117        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
117        │               adc_to_fifo:
           │                            ;
117        │                            ; When we enter the routine, ip should contain PSD0 or PSD1 IPORT
117        │                            ; addr_reg will be used ...should contain PSDx_IPORT (x = 0 or 1)
117        │                            ; Here is the bit map
117        │                            ; NOTE: bit 6 tells us if it is PSD 0 or PSD1
           │                            ;
117        │                            ; 0		psd0_or
117        │                            ; 1		psd0_token_out
117        │                            ; 2		psd0_acq_ack
117        │                            ; 3		psd0_addr_out0
117        │                            ; 4		psd0_addr_out1
117        │                            ; 5		psd0_addr_out2
117        │                            ; 6     0 if PSD 0, 1 if PSD 1
117        │                            ; 7     0
           │
117        │                            ; Push some registers onto stack
           │
117  05A04 ╭──────▶                     or led_reg, 04                 ; Set bit 2  			;DEBUG FLAG 0 START
118  2DA00 │                            output led_reg, LED_PORT       ;DEBUG FLAG 0
           │
119  2E4F0 │                            store cnt, (SP)                ; Push
11A  19F01 │                            sub SP, 01
           │
11B  2E0F0 │                            store op, (SP)                 ; Push
11C  19F01 │                            sub SP, 01
           │
11D  2E1F0 │                            store ip, (SP)                 ; Push
11E  19F01 │                            sub SP, 01
           │
           │
11F        │                            ; Shift right 3 places
11F        │                            ; Lower nybble now contains the channel address (bit 3 is PSD ID)
11F        │                            ; Upper nybble contains 4’b000
           │
11F  14D0E │                            sr0 addr_reg
120  14D0E │                            sr0 addr_reg
121  14D0E │                            sr0 addr_reg
           │
           │
122        │                            ; Load cnt to keep track which output we are working on
122        │                            ; A, B, C, or T (00, 01, 10, 11)
           │
122  01400 │                            load cnt, 00
           │
123        │                            ; Use scr1 to keep track of which PSD chip (either 0 or 1)
123        │                            ; Inspect bit 3 of ip register to see if it is PSD 0 or PSD 1
           │
123  01300 │                            load scr1, 00                  ; PSD 0
124  0DD08 │                            test addr_reg, 08              ; Test bit 3
125  32127 │     ╭⤙                     jump Z, .loop
126  01301 │     │                      load scr1, 01                  ; PSD 1
           │     │
127        │     │                      ; We will write DATA_TAG_PORT first
127        │     │                      ; Format of the data tag byte :
127        │     │                      ; 	xxyyzzzz
127        │     │                      ; 	xx is type (00 = adc, 01 = tstamp, 10 = tdc time, 11 = tdc cal)
127        │     │                      ; 	For ADC, yy = sc (00 = A, 01 = B, 10 = C , 11 =T)
127        │     │                      ;	For tstamp_counter, yy -> 00 = lower 24 bits, 01 = upper 24 bits
127        │     │                      ;	For tdc time, yy = 01 -> TIME1, yy = 10 -> TIME2
127        │     │                      ;	For tdc calibration, yy = 01 = CALIBRATION1, yy = 10 -> CALIBRATION2
127        │     │                      ; 	zz = 4-bit channel address
           │     │
127  000D0 │    ╭┴▶              .loop: load op, addr_reg              ; Load channel address
128  00240 │    │                       load scr0, cnt                 ; Copy cnt (i.e. which analog output) to scr0
129  14206 │    │                       sl0 scr0
12A  14206 │    │                       sl0 scr0
12B  14206 │    │                       sl0 scr0
12C  14206 │    │                       sl0 scr0
12D        │    │                       ; Shift left 4 places
12D  04020 │    │                       or op, scr0                    ; Combine with channel address
12E  2D002 │    │                       output op, DATA_TAG_PORT       ; Put out our data tag (MSbyte of 32-bit word)
           │    │
12F        │    │                       ; Now we will now write ADC_CTL_PORT
12F        │    │                       ; We need to route out the appropriate ADC register to the FIFO using MUX (3 bits)
           │    │
12F  00040 │    │                       load op, cnt                   ; cnt is either (00 = A, 01 = B, 10 = C, 11 = T)
130  14006 │    │                       sl0 op
131  14006 │    │                       sl0 op
132  14006 │    │                       sl0 op
133  14006 │    │                       sl0 op
134        │    │                       ; Mux sel is bits 4, 5, 6 of the ADC_CTL_PORT
           │    │
           │    │
134  0D301 │    │                       test scr1, 01                  ; Test bit 0				; Bit 6 is 0 if PSD 0
135  32137 │    │╭⤙                     jump Z, .skip
136  05040 │    ││                      or op, 40                      ; Set bit 6				; Bit 6 is a 1 if PSD 1
           │    ││
           │    ││
137  2D001 │    │╰▶              .skip: output op, ADC_CTL_PORT
           │    │                       ;
138        │    │                       ; Correct input is now sitting on FIFO input
138        │    │                       ; Wait for ’tready’ signal to be active
           │    │                       ;
           │    │
138  09100 │    │╭▶         .wait_trdy: input ip, STATUS_IPORT
           │    ││
139        │    ││                      ; Test bit 0 of STATUS_PORT (i.e. tready) ... if zero we should wait
           │    ││
139  0D101 │    ││                      test ip, 01                    ; Test bit 0
13A  32138 │    │╰⤙                     jump Z, .wait_trdy
           │    │
           │    │
13B        │    │                       ; When FIFO is ready, send data (what we send to vaild port makes no diff)
           │    │
13B  2D0FE │    │                       output op, VALID_PORT
           │    │
13C        │    │                       ; Check to see if we are done sending A, B, C, T
13C        │    │                       ; When cnt is equal to 4, we are done!
           │    │
13C  11401 │    │                       add cnt, 01
13D  1D404 │    │                       compare cnt, 04
13E  36127 │    ╰─⤙                     jump NZ, .loop
           │
13F        │                            ; Retrieve registers from stack
           │
13F  11F01 │                            add SP, 01                     ; Pop
140  0A1F0 │                            fetch ip, (SP)
           │
141  11F01 │                            add SP, 01                     ; Pop
142  0A0F0 │                            fetch op, (SP)
           │
143  11F01 │                            add SP, 01                     ; Pop
144  0A4F0 │                            fetch cnt, (SP)
           │
           │
145  25000 │                            return
           │
146        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
146        │                            ; Name: get_event
           │                            ;
146        │                            ; Routine to get a nuclear physics event
           │                            ;
146        │                            ; Aquires data from the 4 ADCS (A, B, C, T) for all hit channels on
146        │                            ; both PSD chips!
           │                            ;
146        │                            ; We look at ORs and keep getting samples until both PSD0 and PSD1 ORs low!
146        │                            ; Each time we get A, B, C, T samples, we send them to the FIFO
146        │                            ; Each time send a word to the FIFO, we need to write to VALID_PORT (or LAST_PORT)
           │                            ;
146        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
146        │                 get_event:
           │
146        │                            ; Set the busy bit (also led[1])
146        │                            ; Bit 1 of LED_PORT is led[1] which is also the busy bit!
           │
146  05A02 ╭──────▶                     or led_reg, 02                 ; Set bit 1
147  2DA00 │                            output led_reg, LED_PORT
           │
148        │                            ; We need to set the FIFO mux to select the output of ADC mux
148        │                            ; fifo_mux_sel = 00 (bits 2 and 3 of the MISC_IPORT
           │
148  03CFB │                            and misc_oport_reg, fb         ; Clear bit 2
149  03CF7 │                            and misc_oport_reg, f7         ; Clear bit 3
14A  2DC07 │                            output misc_oport_reg, MISC_OPORT
           │
14B        │                            ; Check the ORs out of PSD chips
14B        │                            ; If both ORs low then we are done!
           │
14B  01900 ╭┬─┬───▶              .loop: load psd_or_reg, 00
14C  01600 ││ │                         load adc_reg, 00
           ││ │
14D  09102 ││ │                         input ip, PSD0_IPORT
14E  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD0 OR
14F  32151 ││ │  ╭⤙                     jump Z, .or0
150  05901 ││ │  │                      or psd_or_reg, 01              ; Set bit 0			; Make note that PSD0 OR is high
