12C  01600 ││ │                         load adc_reg, 00
           ││ │
12D  09102 ││ │                         input ip, PSD0_IPORT
12E  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD0 OR
12F  32131 ││ │  ╭⤙                     jump Z, .or0
130  05901 ││ │  │                      or psd_or_reg, 01              ; Set bit 0			; Make note that PSD0 OR is high
131  09103 ││ │  ╰▶               .or0: input ip, PSD1_IPORT
132  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD1 OR
133  32135 ││ │  ╭⤙                     jump Z, .or1
134  05902 ││ │  │                      or psd_or_reg, 02              ; Set bit 1			; Make note that PSD1 OR is high
           ││ │  │                      ;
135        ││ │  │                      ; Implement a case statement based on lower two bits of psd_or_reg
