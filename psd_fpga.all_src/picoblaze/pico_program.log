101        │                            ; Subroutine Name: adc_conv
           │                            ;
101        │                            ; Pass in adc_clk_mask and adc_conv_mask
101        │                            ; clk_0 is bit 0 of adc_clk_mask
101        │                            ; clk_1 is bit 1 of adc_clk_mask
101        │                            ; conv_0 is bit 2 of adc_conv_mask
101        │                            ; conv_1 is bit 3 of adc_conv_maks
           │                            ;
101        │                            ; Uses the cnt register to count clock pulses (16 bit ADC)
101        │                            ; but restores cnt register before returning!!!
101        │                            ; Use adc_reg but we don’t restore it
           │                            ;
101        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
101        │                  adc_conv:
           │
