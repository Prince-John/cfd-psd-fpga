0A2        │    │                       ; Subroutine Name: time_to_fifo
           │    │                       ;
0A2        │    │                       ; Routine sends time related data to the FIFO
           │    │                       ;
0A2        │    │                       ;	constant	TSTAMP_LOWER_TAG, 40
0A2        │    │                       ;	constant	TSTAMP_UPPER_TAG, 50
0A2        │    │                       ; 	constant	NO_TSTAMP_TAG, FF
           │    │
0A2        │    │                       ;	constant	TDC_TIME1_TAG, 90
0A2        │    │                       ;	constant	TDC_TIME2_TAG, a0
0A2        │    │                       ;	constant	TDC_CAL1_TAG, d0
0A2        │    │                       ;	constant	TDC_CAL2_TAG, e0
           │    │                       ;
0A2        │    │                       ; PORT 7 (MISC_OPORT)
           │    │                       ;
0A2        │    │                       ; 0 	force_psd_reset
0A2        │    │                       ; 1		veto_reset
0A2        │    │                       ; 2		fifo_mux_sel[0]
0A2        │    │                       ; 3		fifo_mux_sel[1]
0A2        │    │                       ; 4		psd_glob_ena
           │    │                       ;
0A2        │    │                       ; fifo_mux_sel = 00 -> adc_data (adc_reg)
0A2        │    │                       ; fifo_mux_sel = 01 -> tdc_data (tdc_reg)
0A2        │    │                       ; fifo_mux_sel = 10 -> tstamp counter (lower)
0A2        │    │                       ; fifo_mux_sel = 11 -> tstamp counter (upper)
           │    │                       ;
0A2        │    │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │    │
0A2        │    │         time_to_fifo:
           │    │
0A2        │    │                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0A2        │    │                       ; Wait for TDC7200 tstamp_rdy to go low
0A2        │    │                       ; Can’t read registers until tstamp_rdy is high!
0A2        │    │                       ; tstamp_rdy is bit 0 of the RDY_IPORT
           │    │                       ;
0A2        │    │                       ; GLE: 15-Nov-2025
0A2        │    │                       ; Modified so all boards send timestamp counter
0A2        │    │                       ; value back!
0A2        │    │                       ; Board0 0 also sends TDC7200 data
0A2        │    │                       ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │    │
0A2  2009C ╭────┴─▶                     call wait_rdy
           │
0A3        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0A3        │                            ; Send tstamp_counter (lower 24 bits)
0A3        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │
0A3  01040 │                            load op, TSTAMP_LOWER_TAG
0A4  2D002 │                            output op, DATA_TAG_PORT
           │
0A5        │                            ; Set the fifo_mux_sel to 10
           │
0A5  05C08 │                            or misc_oport_reg, 08          ; Set bit 3
0A6  03CFB │                            and misc_oport_reg, fb         ; Clear bit 2
0A7  2DC07 │                            output misc_oport_reg, MISC_OPORT
           │
0A8        │                            ; Wait for FIFO to be ready (bit 0 is tready)
           │
0A8  09100 │     ╭▶             .wait0: input ip, STATUS_IPORT
0A9  0D101 │     │                      test ip, 01                    ; Test bit 0
0AA  320A8 │     ╰⤙                     jump Z, .wait0
0AB  2D2FE │                            output scr0, VALID_PORT
           │
0AC        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0AC        │                            ; Send tstamp counter (upper 24 bits)
0AC        │                            ; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
           │
0AC  01050 │                            load op, TSTAMP_UPPER_TAG
0AD  2D002 │                            output op, DATA_TAG_PORT
           │
0AE        │                            ; Set the fifo_mux_sel to 11 (it was 10)
           │
0AE  05C04 │                            or misc_oport_reg, 04          ; Set bit 2
0AF  2DC07 │                            output misc_oport_reg, MISC_OPORT
           │
0B0        │                            ; Check to see if we are board 0 or not
           │
0B0  0B200 │                            fetch scr0, BOARD_ID
0B1  1D200 │                            compare scr0, 00
0B2  320B8 │    ╭─⤙                     jump Z, .board0
           │    │
