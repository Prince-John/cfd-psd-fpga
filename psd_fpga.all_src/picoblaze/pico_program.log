100        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
100        │                            ; Name: adc_to_fifo
           │                            ;
100        │                            ; Each time this routine is called, it sends the A, B, C, T
100        │                            ; adc values to the microblaze FIFO
100        │                            ; ip will be used ...should contain PSDx_IPORT (x = 0 or 1)
           │                            ;
100        │                            ; Tag format:
           │                            ;
100        │                            ; 0		psd addr bit 0
100        │                            ; 1		psd addr bit 1
100        │                            ; 2		psd addr bit 2
100        │                            ; 3		psd addr bit 3 n(0 = PSD 0, 1 = PSD 1)
100        │                            ; 4		bit 0 of sc
100        │                            ; 5		bit 1 of sc
100        │                            ; 6		bit 0 of type
100        │                            ; 7		bit 1 of type
           │
100        │                            ; type = 00 ---> ADC data
100        │                            ; type = 01 ---> Timestamp Counter
100        │                            ; type = 10 ---> TDC TIME1 or TIME 2 value
100        │                            ; type = 11 ---> TDC CALIBRATION1 or CALIBRATION2 value
           │
100        │                            ; sc = 00 -----> integrator A
100        │                            ; sc = 01 -----> integrator B
100        │                            ; sc = 10 -----> integrator C
100        │                            ; sc = 11 -----> time
100        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
100        │               adc_to_fifo:
           │                            ;
100        │                            ; When we enter the routine, ip should contain PSD0 or PSD1 IPORT
100        │                            ; addr_reg will be used ...should contain PSDx_IPORT (x = 0 or 1)
100        │                            ; Here is the bit map
100        │                            ; NOTE: bit 6 tells us if it is PSD 0 or PSD1
           │                            ;
100        │                            ; 0		psd0_or
100        │                            ; 1		psd0_token_out
100        │                            ; 2		psd0_acq_ack
100        │                            ; 3		psd0_addr_out0
100        │                            ; 4		psd0_addr_out1
100        │                            ; 5		psd0_addr_out2
100        │                            ; 6     0 if PSD 0, 1 if PSD 1
100        │                            ; 7     0
           │
100        │                            ; Push some registers onto stack
           │
100  05A04 ╭──────▶                     or led_reg, 04                 ; Set bit 2  			;DEBUG FLAG 0 START
101  2DA00 │                            output led_reg, LED_PORT       ;DEBUG FLAG 0
           │
102  2E4F0 │                            store cnt, (SP)                ; Push
103  19F01 │                            sub SP, 01
           │
104  2E0F0 │                            store op, (SP)                 ; Push
105  19F01 │                            sub SP, 01
           │
106  2E1F0 │                            store ip, (SP)                 ; Push
107  19F01 │                            sub SP, 01
           │
           │
108        │                            ; Shift right 3 places
108        │                            ; Lower nybble now contains the channel address (bit 3 is PSD ID)
108        │                            ; Upper nybble contains 4’b000
           │
108  14D0E │                            sr0 addr_reg
109  14D0E │                            sr0 addr_reg
10A  14D0E │                            sr0 addr_reg
           │
           │
10B        │                            ; Load cnt to keep track which output we are working on
10B        │                            ; A, B, C, or T (00, 01, 10, 11)
           │
10B  01400 │                            load cnt, 00
           │
10C        │                            ; Use scr1 to keep track of which PSD chip (either 0 or 1)
10C        │                            ; Inspect bit 3 of ip register to see if it is PSD 0 or PSD 1
           │
10C  01300 │                            load scr1, 00                  ; PSD 0
10D  0DD08 │                            test addr_reg, 08              ; Test bit 3
10E  32110 │     ╭⤙                     jump Z, .loop
10F  01301 │     │                      load scr1, 01                  ; PSD 1
           │     │
110        │     │                      ; We will write DATA_TAG_PORT first
110        │     │                      ; Format of the data tag byte :
110        │     │                      ; 	xxyyzzzz
110        │     │                      ; 	xx is type (00 = adc, 01 = tstamp, 10 = tdc time, 11 = tdc cal)
110        │     │                      ; 	For ADC, yy = sc (00 = A, 01 = B, 10 = C , 11 =T)
110        │     │                      ;	For tstamp_counter, yy -> 00 = lower 24 bits, 01 = upper 24 bits
110        │     │                      ;	For tdc time, yy = 01 -> TIME1, yy = 10 -> TIME2
110        │     │                      ;	For tdc calibration, yy = 01 = CALIBRATION1, yy = 10 -> CALIBRATION2
110        │     │                      ; 	zz = 4-bit channel address
           │     │
110  000D0 │    ╭┴▶              .loop: load op, addr_reg              ; Load channel address
111  00240 │    │                       load scr0, cnt                 ; Copy cnt (i.e. which analog output) to scr0
112  14206 │    │                       sl0 scr0
113  14206 │    │                       sl0 scr0
114  14206 │    │                       sl0 scr0
115  14206 │    │                       sl0 scr0
116        │    │                       ; Shift left 4 places
116  04020 │    │                       or op, scr0                    ; Combine with channel address
117  2D002 │    │                       output op, DATA_TAG_PORT       ; Put out our data tag (MSbyte of 32-bit word)
           │    │
118        │    │                       ; Now we will now write ADC_CTL_PORT
118        │    │                       ; We need to route out the appropriate ADC register to the FIFO using MUX (3 bits)
           │    │
118  00040 │    │                       load op, cnt                   ; cnt is either (00 = A, 01 = B, 10 = C, 11 = T)
119  14006 │    │                       sl0 op
11A  14006 │    │                       sl0 op
11B  14006 │    │                       sl0 op
11C  14006 │    │                       sl0 op
11D        │    │                       ; Mux sel is bits 4, 5, 6 of the ADC_CTL_PORT
           │    │
           │    │
11D  0D301 │    │                       test scr1, 01                  ; Test bit 0				; Bit 6 is 0 if PSD 0
11E  32120 │    │╭⤙                     jump Z, .skip
11F  05040 │    ││                      or op, 40                      ; Set bit 6				; Bit 6 is a 1 if PSD 1
           │    ││
           │    ││
120  2D001 │    │╰▶              .skip: output op, ADC_CTL_PORT
           │    │                       ;
121        │    │                       ; Correct input is now sitting on FIFO input
121        │    │                       ; Wait for ’tready’ signal to be active
           │    │                       ;
           │    │
121  09100 │    │╭▶         .wait_trdy: input ip, STATUS_IPORT
           │    ││
122        │    ││                      ; Test bit 0 of STATUS_PORT (i.e. tready) ... if zero we should wait
           │    ││
122  0D101 │    ││                      test ip, 01                    ; Test bit 0
123  32121 │    │╰⤙                     jump Z, .wait_trdy
           │    │
           │    │
124        │    │                       ; When FIFO is ready, send data (what we send to vaild port makes no diff) --Prince: How do we know that the data is ready and stable?
           │    │
124  2D0FE │    │                       output op, VALID_PORT
           │    │
125        │    │                       ; Check to see if we are done sending A, B, C, T
125        │    │                       ; When cnt is equal to 4, we are done!
           │    │
125  11401 │    │                       add cnt, 01
126  1D404 │    │                       compare cnt, 04
127  36110 │    ╰─⤙                     jump NZ, .loop
           │
128        │                            ; Retrieve registers from stack
           │
128  11F01 │                            add SP, 01                     ; Pop
129  0A1F0 │                            fetch ip, (SP)
           │
12A  11F01 │                            add SP, 01                     ; Pop
12B  0A0F0 │                            fetch op, (SP)
           │
12C  11F01 │                            add SP, 01                     ; Pop
12D  0A4F0 │                            fetch cnt, (SP)
           │
           │
12E  25000 │                            return
           │
