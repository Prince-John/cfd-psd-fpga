127  09102 ││ │                         input ip, PSD0_IPORT
128  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD0 OR
129  3212B ││ │  ╭⤙                     jump Z, .or0
12A  05901 ││ │  │                      or psd_or_reg, 01              ; Set bit 0			; Make note that PSD0 OR is high
12B  09103 ││ │  ╰▶               .or0: input ip, PSD1_IPORT
12C  0D101 ││ │                         test ip, 01                    ; Test bit 0					; Testing PSD1 OR
12D  3212F ││ │  ╭⤙                     jump Z, .or1
12E  05902 ││ │  │                      or psd_or_reg, 02              ; Set bit 1			; Make note that PSD1 OR is high
           ││ │  │                      ;
