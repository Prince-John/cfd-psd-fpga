058        │││  │                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │││  │
058  03BBF ╭───┬──▶        tdc_csb_low: and tdc_ctl_reg, bf            ; Clear bit 6
059  2DB04 │││ ││                       output tdc_ctl_reg, TDC_CTL_PORT
05A  25000 │││ ││                       return
           │││ ││
           │││ ││                       ;
05B        │││ ││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
