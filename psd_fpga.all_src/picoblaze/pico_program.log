066        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
066        │ ││││                       ; Subroutine Name: config_tdc
           │ ││││                       ;
066        │ ││││                       ; When we enter, addr_reg should contain the configuration
066        │ ││││                       ; register address we want to load, either CONFGI1 or CONFIG2
           │ ││││                       ;
066        │ ││││                       ; Also, when we enter, op register should contain the
066        │ ││││                       ; configuration value, either CONFIG1_VAL or CONFIG2_VAL
           │ ││││                       ;
066        │ ││││                       ; Loads the TDC7200 CONFIG1 or CONFIG2 register
066        │ ││││                       ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │ ││││
066  20052 │╭───┴┬▶         config_tdc: call clr_tdc_reg
           │││││ │
067        │││││ │                      ; Load address information and write to TDC_DATA_PORT
067        │││││ │                      ; addr_reg is passed into routine and contains address
067        │││││ │                      ; of TDC7200 register we want to load!
           │││││ │
067  2DD03 │││││ │                      output addr_reg, TDC_DATA_PORT
           │││││ │
068        │││││ │                      ; Assert ld[2] control (most significant byte of tdc register)
068        │││││ │                      ; Synchronous load so we need to apply a clock pulse!
068        │││││ │                      ; ld[2] is bit 2 of the TDC_CTL_PORT
           │││││ │
068  05B04 │││││ │                      or tdc_ctl_reg, 04             ; Set bit 2
069  2DB04 │││││ │                      output tdc_ctl_reg, TDC_CTL_PORT
06A  2004D ││╰────⤙                     call tdc_reg_clk
06B  03BFB ││ ││ │                      and tdc_ctl_reg, fb            ; Clear bit 2
06C  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
06D        ││ ││ │                      ; Write value to TDC_DATA_PORT
06D        ││ ││ │                      ; The op register is passed into routine and contains the data value
           ││ ││ │
06D  2D003 ││ ││ │                      output op, TDC_DATA_PORT
           ││ ││ │
06E        ││ ││ │                      ; Assert ld[1] control (middle byte of tdc register)
06E        ││ ││ │                      ; ld[1] is bit 1 of TDC_CTL_PORT
           ││ ││ │
06E  05B02 ││ ││ │                      or tdc_ctl_reg, 02             ; Set bit 1
06F  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
070  2004D ╰──────⤙                     call tdc_reg_clk
071  03BFD ││ ││ │                      and tdc_ctl_reg, fd            ; Clear bit 1
072  2DB04 ││ ││ │                      output tdc_ctl_reg, TDC_CTL_PORT
           ││ ││ │
073        ││ ││ │                      ; Bring tdc_csb pin low (active)
           ││ ││ │
073  20058 ││ │╰──⤙                     call tdc_csb_low
           ││ │  │
074        ││ │  │                      ; Load cnt with the number of clock pulses we want i.e. 16
074        ││ │  │                      ; We need 8 clocks to load register address and 8 to load the value
074        ││ │  │                      ; Address goes in first followed by data
           ││ │  │
074  01410 ││ │  │                      load cnt, 16'd
           ││ │  │
075        ││ │  │                      ; Call our TDC serial routine
           ││ │  │
075  20083 ││ │╭──⤙                     call tdc_serial
           ││ ││ │
076        ││ ││ │                      ; Bring tdc_csb pin high (inactive)
           ││ ││ │
076  2005B ││ ╰───⤙                     call tdc_csb_high
           ││  │ │
077  25000 ││  │ │                      return
           ││  │ │
