04D        │  ││                        ; Subroutine Name: dly_100ms
           │  ││                        ;
04D        │  ││                        ; Delay for "about" 100ms by repeatly calling
04D        │  ││                        ; delay_1us subroutine
04D        │  ││                        ; Note: 100,000 is $0186A0
           │  ││                        ;
04D        │  ││                        ; Uses scr0, scr1, cnt but does NOT destroys them
04D        │  ││                        ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │  ││
04D        │  ││             dly_100ms:
           │  ││
04D        │  ││                        ; Push regs onto stack
           │  ││
04D  2E2F0 │╭─╰───▶                     store scr0, (SP)               ; Push
04E  19F01 ││  │                        sub SP, 01
           ││  │
04F  2E3F0 ││  │                        store scr1, (SP)               ; Push
050  19F01 ││  │                        sub SP, 01
           ││  │
051  2E4F0 ││  │                        store cnt, (SP)                ; Push
052  19F01 ││  │                        sub SP, 01
           ││  │
           ││  │
053  01401 ││  │                        load cnt, 01
054  01386 ││  │                        load scr1, 86
055  012A0 ││  │                        load scr0, A0
056  20034 ││  ╰─┬⤙              .loop: call dly_us
057  19201 ││    │                      sub scr0, 01
058  1B300 ││    │                      subcy scr1, 00
059  1B400 ││    │                      subcy cnt, 00
05A  3E056 ││    ╰⤙                     jump NC, .loop
           ││
05B        ││                           ; Restore registers
           ││
05B  11F01 ││                           add SP, 01                     ; Pop
05C  0A4F0 ││                           fetch cnt, (SP)
           ││
05D  11F01 ││                           add SP, 01                     ; Pop
05E  0A3F0 ││                           fetch scr1, (SP)
           ││
05F  11F01 ││                           add SP, 01                     ; Pop
060  0A2F0 ││                           fetch scr0, (SP)
           ││
           ││
061  25000 ││                           return
