0EF        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
0EF        │                            ; Name: adc_to_fifo
           │                            ;
0EF        │                            ; Each time this routine is called, it sends the A, B, C, T
0EF        │                            ; adc values to the microblaze FIFO
0EF        │                            ; ip will be used ...should contain PSDx_IPORT (x = 0 or 1)
           │                            ;
0EF        │                            ; Tag format:
           │                            ;
0EF        │                            ; 0		psd addr bit 0
0EF        │                            ; 1		psd addr bit 1
0EF        │                            ; 2		psd addr bit 2
0EF        │                            ; 3		psd addr bit 3 n(0 = PSD 0, 1 = PSD 1)
0EF        │                            ; 4		bit 0 of sc
0EF        │                            ; 5		bit 1 of sc
0EF        │                            ; 6		bit 0 of type
0EF        │                            ; 7		bit 1 of type
           │
0EF        │                            ; type = 00 ---> ADC data
0EF        │                            ; type = 01 ---> Timestamp Counter
0EF        │                            ; type = 10 ---> TDC TIME1 or TIME 2 value
0EF        │                            ; type = 11 ---> TDC CALIBRATION1 or CALIBRATION2 value
           │
0EF        │                            ; sc = 00 -----> integrator A
0EF        │                            ; sc = 01 -----> integrator B
0EF        │                            ; sc = 10 -----> integrator C
0EF        │                            ; sc = 11 -----> time
0EF        │                            ; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
           │
0EF        │               adc_to_fifo:
           │                            ;
0EF        │                            ; When we enter the routine, ip should contain PSD0 or PSD1 IPORT
0EF        │                            ; addr_reg will be used ...should contain PSDx_IPORT (x = 0 or 1)
0EF        │                            ; Here is the bit map
0EF        │                            ; NOTE: bit 6 tells us if it is PSD 0 or PSD1
           │                            ;
0EF        │                            ; 0		psd0_or
0EF        │                            ; 1		psd0_token_out
0EF        │                            ; 2		psd0_acq_ack
0EF        │                            ; 3		psd0_addr_out0
0EF        │                            ; 4		psd0_addr_out1
0EF        │                            ; 5		psd0_addr_out2
0EF        │                            ; 6     0 if PSD 0, 1 if PSD 1
0EF        │                            ; 7     0
           │
0EF        │                            ; Push some registers onto stack
           │
0EF  05A04 ╭──────▶                     or led_reg, 04                 ; Set bit 2  			;DEBUG FLAG 0 START
0F0  2DA00 │                            output led_reg, LED_PORT       ;DEBUG FLAG 0
           │
0F1  2E4F0 │                            store cnt, (SP)                ; Push
0F2  19F01 │                            sub SP, 01
           │
0F3  2E0F0 │                            store op, (SP)                 ; Push
0F4  19F01 │                            sub SP, 01
           │
0F5  2E1F0 │                            store ip, (SP)                 ; Push
0F6  19F01 │                            sub SP, 01
           │
           │
0F7        │                            ; Shift right 3 places
0F7        │                            ; Lower nybble now contains the channel address (bit 3 is PSD ID)
0F7        │                            ; Upper nybble contains 4’b000
           │
0F7  14D0E │                            sr0 addr_reg
0F8  14D0E │                            sr0 addr_reg
0F9  14D0E │                            sr0 addr_reg
           │
           │
0FA        │                            ; Load cnt to keep track which output we are working on
0FA        │                            ; A, B, C, or T (00, 01, 10, 11)
           │
0FA  01400 │                            load cnt, 00
           │
0FB        │                            ; Use scr1 to keep track of which PSD chip (either 0 or 1)
0FB        │                            ; Inspect bit 3 of ip register to see if it is PSD 0 or PSD 1
           │
0FB  01300 │                            load scr1, 00                  ; PSD 0
0FC  0DD08 │                            test addr_reg, 08              ; Test bit 3
0FD  320FF │     ╭⤙                     jump Z, .loop
0FE  01301 │     │                      load scr1, 01                  ; PSD 1
           │     │
0FF        │     │                      ; We will write DATA_TAG_PORT first
0FF        │     │                      ; Format of the data tag byte :
0FF        │     │                      ; 	xxyyzzzz
0FF        │     │                      ; 	xx is type (00 = adc, 01 = tstamp, 10 = tdc time, 11 = tdc cal)
0FF        │     │                      ; 	For ADC, yy = sc (00 = A, 01 = B, 10 = C , 11 =T)
0FF        │     │                      ;	For tstamp_counter, yy -> 00 = lower 24 bits, 01 = upper 24 bits
0FF        │     │                      ;	For tdc time, yy = 01 -> TIME1, yy = 10 -> TIME2
0FF        │     │                      ;	For tdc calibration, yy = 01 = CALIBRATION1, yy = 10 -> CALIBRATION2
0FF        │     │                      ; 	zz = 4-bit channel address
           │     │
0FF  000D0 │    ╭┴▶              .loop: load op, addr_reg              ; Load channel address
100  00240 │    │                       load scr0, cnt                 ; Copy cnt (i.e. which analog output) to scr0
101  14206 │    │                       sl0 scr0
102  14206 │    │                       sl0 scr0
103  14206 │    │                       sl0 scr0
104  14206 │    │                       sl0 scr0
105        │    │                       ; Shift left 4 places
105  04020 │    │                       or op, scr0                    ; Combine with channel address
106  2D002 │    │                       output op, DATA_TAG_PORT       ; Put out our data tag (MSbyte of 32-bit word)
           │    │
107        │    │                       ; Now we will now write ADC_CTL_PORT
107        │    │                       ; We need to route out the appropriate ADC register to the FIFO using MUX (3 bits)
           │    │
107  00040 │    │                       load op, cnt                   ; cnt is either (00 = A, 01 = B, 10 = C, 11 = T)
108  14006 │    │                       sl0 op
109  14006 │    │                       sl0 op
10A  14006 │    │                       sl0 op
10B  14006 │    │                       sl0 op
10C        │    │                       ; Mux sel is bits 4, 5, 6 of the ADC_CTL_PORT
           │    │
           │    │
10C  0D301 │    │                       test scr1, 01                  ; Test bit 0				; Bit 6 is 0 if PSD 0
10D  3210F │    │╭⤙                     jump Z, .skip
10E  05040 │    ││                      or op, 40                      ; Set bit 6				; Bit 6 is a 1 if PSD 1
           │    ││
           │    ││
10F  2D001 │    │╰▶              .skip: output op, ADC_CTL_PORT
           │    │                       ;
110        │    │                       ; Correct input is now sitting on FIFO input
110        │    │                       ; Wait for ’tready’ signal to be active
           │    │                       ;
           │    │
110  09100 │    │╭▶         .wait_trdy: input ip, STATUS_IPORT
           │    ││
111        │    ││                      ; Test bit 0 of STATUS_PORT (i.e. tready) ... if zero we should wait
           │    ││
111  0D101 │    ││                      test ip, 01                    ; Test bit 0
112  32110 │    │╰⤙                     jump Z, .wait_trdy
           │    │
           │    │
113        │    │                       ; When FIFO is ready, send data (what we send to vaild port makes no diff) --Prince: How do we know that the data is ready and stable?
           │    │
113  2D0FE │    │                       output op, VALID_PORT
           │    │
114        │    │                       ; Check to see if we are done sending A, B, C, T
114        │    │                       ; When cnt is equal to 4, we are done!
           │    │
114  11401 │    │                       add cnt, 01
115  1D404 │    │                       compare cnt, 04
116  360FF │    ╰─⤙                     jump NZ, .loop
           │
117        │                            ; Retrieve registers from stack
           │
117  11F01 │                            add SP, 01                     ; Pop
118  0A1F0 │                            fetch ip, (SP)
           │
119  11F01 │                            add SP, 01                     ; Pop
11A  0A0F0 │                            fetch op, (SP)
           │
11B  11F01 │                            add SP, 01                     ; Pop
11C  0A4F0 │                            fetch cnt, (SP)
           │
           │
11D  25000 │                            return
           │
