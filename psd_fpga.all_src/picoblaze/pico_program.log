0DB        │                            ; Subroutine Name: adc_conv
           │                            ;
0DB        │                            ; Pass in adc_clk_mask and adc_conv_mask
0DB        │                            ; clk_0 is bit 0 of adc_clk_mask
0DB        │                            ; clk_1 is bit 1 of adc_clk_mask
